---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { featureGroups, featureDisplayNames, columnTooltips } from '../data/feature-metadata';
import { buildFaviconMap } from '../lib/favicon-map';
import { loadRankings } from '../lib/rankings';
import { buildLinkMaps, canonicalQueryLanguage } from '../lib/ranking-boards';
import { loadGithubStars, formatGithubStars } from '../lib/github-stars';
import { sortProtocols } from '../lib/protocols';

const ranking = await loadRankings();
const linkMaps = ranking ? buildLinkMaps(ranking) : null;

const databases = await getCollection('databases');

// Default-sort by overall rank when rankings are loaded (ranked engines first, by rank
// ascending; unranked/Insufficient engines fall to the end, alphabetically).
databases.sort((a, b) => {
  if (linkMaps) {
    const ra = linkMaps.overallRank.get(a.data.slug);
    const rb = linkMaps.overallRank.get(b.data.slug);
    if (ra !== undefined && rb !== undefined) return ra - rb;
    if (ra !== undefined) return -1;
    if (rb !== undefined) return 1;
  }
  return a.data.name.localeCompare(b.data.name);
});

// Slugs with a real logo; a fallback lookup leaves the slug absent (see buildFaviconMap).
const [faviconMap, githubStars] = await Promise.all([
  buildFaviconMap(databases),
  loadGithubStars(databases),
]);
const hasGithubRepositories = databases.some((db) => Boolean(db.data.github_url));

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Graph Database Comparison",
  "description": `Compare features across ${databases.length}+ graph databases, extensions, and query engines.`,
  "url": "https://gdb-engines.com",
  "numberOfItems": databases.length,
  "dateModified": new Date().toISOString().split('T')[0],
  // Items point to our own /db/{slug}/ pages (which carry their own SoftwareApplication
  // schema). This gives crawlers a stitchable chain instead of bouncing off to vendor sites,
  // and drops a substantial HTML payload from the homepage.
  "itemListElement": databases.map((db, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `https://gdb-engines.com/db/${db.data.slug}/`,
    "name": db.data.name,
  })),
});

// Dataset schema exposes the catalog to Google Dataset Search, with api.json as the
// machine-readable distribution.
const datasetJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "Graph Database Engines Comparison",
  "description": `Structured comparison of ${databases.length}+ graph databases, extensions, and query engines — features, licenses, query languages, implementation languages, and monthly popularity rankings.`,
  "url": "https://gdb-engines.com",
  "keywords": ["graph database", "database comparison", "query language", "Cypher", "Gremlin", "SPARQL", "GQL", "SQL/PGQ"],
  "creator": { "@type": "Organization", "name": "GDB-Engines", "url": "https://gdb-engines.com" },
  "license": "https://github.com/cjlm/gdb-engines/blob/main/LICENSE",
  "isAccessibleForFree": true,
  "dateModified": new Date().toISOString().split('T')[0],
  "distribution": [{
    "@type": "DataDownload",
    "encodingFormat": "application/json",
    "contentUrl": "https://gdb-engines.com/api.json",
  }],
});
---
<Layout
  title={`GDB-Engines — Compare ${databases.length}+ Graph Databases`}
  jsonLd={[jsonLd, datasetJsonLd]}
  description={`Compare ${databases.length}+ graph databases side-by-side — features, licenses, query languages, and monthly popularity rankings.`}
>
  <SiteHeader comparisonControls sponsorBadge />

  <h1 class="sr-only">Graph Database Comparison — {databases.length}+ Engines</h1>

  <div class="comparison-stage">
    <table>
    <thead>
      <tr>
        {linkMaps && <th class="sortable rank-col" data-type="number"><div class="header-container"><span class="has-tooltip" aria-label="Position in the overall Graph Database Popularity Ranking" data-microtip-position="bottom-right" role="tooltip">Rank</span> <span class="sort-indicator">↑</span></div></th>}
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.name} data-microtip-position="bottom-right" role="tooltip">Name</span> <span class="sort-indicator"></span></div></th>
        {hasGithubRepositories && (
          <th class="sortable github-col" data-type="number">
            <div class="header-container">
              <span class="github-header has-tooltip" aria-label={columnTooltips.github_stars} data-microtip-position="bottom" role="tooltip">
                GitHub
              </span>
              <span class="sort-indicator"></span>
            </div>
          </th>
        )}
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.vendor} data-microtip-position="bottom-right" role="tooltip">Vendor</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.type} data-microtip-position="bottom" role="tooltip">Type</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.kind} data-microtip-position="bottom" role="tooltip">Kind</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.category} data-microtip-position="bottom" role="tooltip">Category</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.released} data-microtip-position="bottom" role="tooltip">Released</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text" style="display:none"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.status} data-microtip-position="bottom" role="tooltip">Status</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="boolean"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.gdotv} data-microtip-position="bottom" role="tooltip">GdotV</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.license} data-microtip-position="bottom" role="tooltip">License</span> <span class="sort-indicator"></span></div></th>
        <th class="sortable" data-type="text"><div class="header-container"><span class="has-tooltip" aria-label={columnTooltips.implementation_language} data-microtip-position="bottom" role="tooltip">Language</span> <span class="sort-indicator"></span></div></th>
        <th><span class="has-tooltip" aria-label={columnTooltips.query_languages} data-microtip-position="bottom" role="tooltip">Query Languages</span></th>
        <th><span class="has-tooltip" aria-label={columnTooltips.protocols} data-microtip-position="bottom-left" role="tooltip">Protocols</span></th>
        {featureGroups.map((group, gi) =>
          group.features.map(key => (
            <th class="feature-col sortable" data-group={gi} data-type="score">
              {featureDisplayNames[key]} <span class="sort-indicator"></span>
            </th>
          ))
        )}
      </tr>
    </thead>
    <tbody>
      {databases.map(db => (
        <tr class={db.data.status !== 'active' ? `row-${db.data.status}` : ''} data-previous-vendors={db.data.previous_vendors?.join(',') || ''} data-previous-names={db.data.previous_names?.join(',') || ''}>
          {linkMaps && (
            <td class="rank-col">{linkMaps.overallRank.has(db.data.slug)
              ? (() => {
                  const rank = linkMaps.overallRank.get(db.data.slug);
                  const d = linkMaps.overallDelta1m.get(db.data.slug);
                  const deltaText = d === null || d === undefined ? null
                    : d === 'new' ? 'new'
                    : d === 0 ? null
                    : d < 0 ? `▲${Math.abs(d)}` : `▼${d}`;
                  const deltaCls = d === 'new' ? 'delta-new'
                    : typeof d === 'number' && d < 0 ? 'delta-up'
                    : typeof d === 'number' && d > 0 ? 'delta-down' : '';
                  return (
                    <a href="/rankings/overall/" class="rank-link">
                      <span class="rank-num">{rank}</span>
                      <span class={`rank-delta ${deltaCls}`}>{deltaText}</span>
                    </a>
                  );
                })()
              : <span class="rank-link"><span class="rank-num rank-empty">—</span><span class="rank-delta"></span></span>}</td>
          )}
          <td>
            <div class="database-cell">
              {(() => {
                const fav = faviconMap[db.data.slug];
                return fav ? (
                  <img
                    src={fav}
                    alt=""
                    width="20"
                    height="20"
                    loading="lazy"
                  />
                ) : (
                  <span class="icon-placeholder" />
                );
              })()}
              <a href={`/db/${db.data.slug}/`} class="has-tooltip" aria-label={db.data.description + (db.data.previous_names?.length ? `\nPreviously: ${db.data.previous_names.join(' → ')}` : '')} data-microtip-position="top-right" data-microtip-size="medium" role="tooltip">{db.data.name}</a>
              {db.data.url && (
                <span class="db-links">
                  <a href={`${db.data.url}${db.data.url.includes('?') ? '&' : '?'}utm_source=gdb-engines&utm_medium=referral`} target="_blank" rel="noopener noreferrer" title={db.data.url}>
                    <svg width="14" height="14"><use href="#icon-external" /></svg>
                  </a>
                </span>
              )}
            </div>
          </td>
          {hasGithubRepositories && (
            <td
              class="github-col"
              data-sort-value={typeof githubStars[db.data.slug] === 'number' ? githubStars[db.data.slug] : undefined}
            >
              {db.data.github_url ? (
                <a
                  class="github-cell"
                  href={db.data.github_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  title={typeof githubStars[db.data.slug] === 'number'
                    ? `${githubStars[db.data.slug]!.toLocaleString('en-US')} GitHub stars — ${db.data.github_url}`
                    : db.data.github_url}
                >
                  <svg class="github-mark" width="16" height="16" aria-hidden="true"><use href="#icon-github" /></svg>
                  <span class="sr-only">GitHub repository</span>
                  <span class={`github-star-group ${typeof githubStars[db.data.slug] === 'number' ? '' : 'github-stars-missing'}`}>
                    {typeof githubStars[db.data.slug] === 'number'
                      ? <svg class="github-star" width="12" height="12" aria-hidden="true"><use href="#icon-star" /></svg>
                      : <span class="github-star-slot" aria-hidden="true" />}
                    <span class="github-star-count">{typeof githubStars[db.data.slug] === 'number' ? formatGithubStars(githubStars[db.data.slug]!) : '—'}</span>
                  </span>
                </a>
              ) : (
                <span class="github-cell github-cell-empty" aria-label="No GitHub repository">
                  <span class="github-mark-slot" aria-hidden="true" />
                  <span class="github-star-group github-stars-missing">
                    <span class="github-star-slot" aria-hidden="true" />
                    <span class="github-star-count">—</span>
                  </span>
                </span>
              )}
            </td>
          )}
          <td>
            {db.data.previous_vendors?.length ? (
              <span class="has-tooltip" aria-label={`Previously: ${db.data.previous_vendors.join(' → ')}`} data-microtip-position="top" role="tooltip">
                {db.data.vendor}
              </span>
            ) : (db.data.vendor ?? '-')}
          </td>
          <td>
            {linkMaps?.typeSlug.has(db.data.type) ? (
              <a href={`/rankings/${linkMaps.typeSlug.get(db.data.type)}/`} class={`badge badge-${db.data.type.toLowerCase().replace(/ /g, '-')} badge-link`}>
                {db.data.type === 'Property Graph' ? 'LPG' : db.data.type}
              </a>
            ) : (
              <span class={`badge badge-${db.data.type.toLowerCase().replace(/ /g, '-')}`}>
                {db.data.type === 'Property Graph' ? 'LPG' : db.data.type}
              </span>
            )}
          </td>
          <td>
            {db.data.kind !== 'database' ? (
              linkMaps?.kindSlug.has(db.data.kind) ? (
                <a href={`/rankings/${linkMaps.kindSlug.get(db.data.kind)}/`} class={`badge badge-${db.data.kind} badge-link`}>
                  {db.data.kind === 'query-engine' ? 'Query Engine' : db.data.kind === 'extension' ? 'Extension' : db.data.kind === 'library' ? 'Library' : 'Embedded'}
                </a>
              ) : (
                <span class={`badge badge-${db.data.kind}`}>
                  {db.data.kind === 'query-engine' ? 'Query Engine' : db.data.kind === 'extension' ? 'Extension' : db.data.kind === 'library' ? 'Library' : 'Embedded'}
                </span>
              )
            ) : ''}
          </td>
          <td>
            <span class={`badge badge-${db.data.category.toLowerCase()}`}>
              {db.data.category}
            </span>
          </td>
          <td>{db.data.released ? db.data.released.slice(0, 4) : '-'}</td>
          <td style="display:none">
            {db.data.status !== 'active' ? (
              db.data.status_note ? (
                <span class={`badge badge-${db.data.status} has-tooltip`} aria-label={db.data.status_note} data-microtip-position="top" role="tooltip">
                  {db.data.status === 'inactive' ? 'Inactive' : 'Deprecated'}
                </span>
              ) : (
                <span class={`badge badge-${db.data.status}`}>
                  {db.data.status === 'inactive' ? 'Inactive' : 'Deprecated'}
                </span>
              )
            ) : ''}
          </td>
          <td>{db.data.gdotv_support ? <a href={`${db.data.gdotv_url || 'https://gdotv.com'}${(db.data.gdotv_url || 'https://gdotv.com').includes('?') ? '&' : '?'}utm_source=gdb-engines&utm_medium=referral`} target="_blank" rel="noopener noreferrer">Yes</a> : 'No'}</td>
          <td>{db.data.license
            ? (() => {
                const tierSlug = linkMaps?.licenseTierSlug(db.data.license);
                return tierSlug
                  ? <a href={`/rankings/${tierSlug}/`} class="value-link">{db.data.license}</a>
                  : db.data.license;
              })()
            : '-'}</td>
          <td>{db.data.implementation_language
            ? (linkMaps?.implementationLanguageSlug.has(db.data.implementation_language)
              ? <a href={`/rankings/${linkMaps.implementationLanguageSlug.get(db.data.implementation_language)}/`} class="value-link">{db.data.implementation_language}</a>
              : db.data.implementation_language)
            : '-'}</td>
          <td>
            {db.data.query_languages?.length ? (
              <div class="query-langs">
                {[...db.data.query_languages].sort((a, b) => a.localeCompare(b)).slice(0, 3).map(lang => {
                  const slug = linkMaps?.queryLanguageSlug.get(canonicalQueryLanguage(lang));
                  return slug
                    ? <a href={`/rankings/${slug}/`} class="badge badge-query-lang badge-link">{lang}</a>
                    : <span class="badge badge-query-lang">{lang}</span>;
                })}
                {db.data.query_languages.length > 3 && (
                  <span class="badge badge-query-lang has-tooltip" aria-label={[...db.data.query_languages].sort((a, b) => a.localeCompare(b)).slice(3).join(', ')} data-microtip-position="top" role="tooltip">+{db.data.query_languages.length - 3}</span>
                )}
              </div>
            ) : '-'}
          </td>
          <td>
            {db.data.protocols?.length ? (
              <div class="query-langs">
                {sortProtocols(db.data.protocols).slice(0, 3).map(p => (
                  <span class="badge badge-protocol">{p}</span>
                ))}
                {db.data.protocols.length > 3 && (
                  <span class="badge badge-protocol has-tooltip" aria-label={sortProtocols(db.data.protocols).slice(3).join(', ')} data-microtip-position="top" role="tooltip">+{db.data.protocols.length - 3}</span>
                )}
              </div>
            ) : '-'}
          </td>
          {featureGroups.map((group, gi) =>
            group.features.map(key => {
              const features = db.data.features;
              const value = features ? features[key as keyof typeof features] : undefined;
              return (
                <td class="feature-col" data-group={gi}>
                  {value !== undefined ? (
                    <div class="bar-indicator">
                      <div class="bar-fill" style={`width: ${value * 100}%`} data-score={value}></div>
                    </div>
                  ) : '-'}
                </td>
              );
            })
          )}
        </tr>
      ))}
    </tbody>
    </table>
  </div>

  <footer class="site-footer">
    <span>Last updated: {new Date().toISOString().split('T')[0]}</span>
    <span><a href="/rankings/">Rankings</a></span>
    <span><a href="/about/">About & Changelog</a></span>
  </footer>

  <dialog id="modal">
    <div class="header">
      <h2>About</h2>
      <button id="close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
          <line x1="18" y1="6" x2="6" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          <line x1="6" y1="6" x2="18" y2="18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </button>
    </div>
    <div class="body">
      <p>
        <a href="/">gdb-engines.com</a> is an Open Source comparison of graph database features and capabilities.
      </p>
      <p>
        While most entries are databases, the landscape includes query engines, embedded libraries, and other graph technologies.
      </p>
      <h2>API</h2>
      <p>You can access this data through an API.</p>
      <div class="code-block">
        <code>curl <a href="/api.json">https://gdb-engines.com/api.json</a></code>
      </div>
      <h2>Research Features</h2>
      <p>
        The "Research Features" toggle in the menu reveals 43 feature scores from: Coimbra, M. E., Svitakova, L., Francisco, A. P., &amp; Veiga, L. (2025). <em>Survey: Graph Databases.</em>{' '}
        <a href="https://arxiv.org/abs/2505.24758" target="_blank" rel="noopener noreferrer">arXiv:2505.24758</a>.
        Scores range from 0 (not available) to 1 (fully implemented), evaluated using criteria defined in the paper.
      </p>
      <h2>Contribute</h2>
      <p>
        The data is stored in the{' '}
        <a href="https://github.com/cjlm/gdb-engines" target="_blank" rel="noopener noreferrer">GitHub repo</a>{' '}
        as TOML files. Feel free to edit the data and submit a pull request.
      </p>
    </div>
    <div class="footer">
      <a href="/rankings/">Rankings</a>
      <a href="/about/">About &amp; Changelog</a>
      <a href="mailto:contact@gdb-engines.com">contact@gdb-engines.com</a>
      <a href="https://github.com/cjlm/gdb-engines" target="_blank" rel="noopener noreferrer">Edit on GitHub</a>
    </div>
  </dialog>
  <script src="../scripts/table.ts"></script>
</Layout>

<style>
  .comparison-stage {
    width: max-content;
    min-width: 100%;
    padding-top: var(--header-height);
  }

  .comparison-stage table {
    margin-top: 0;
  }
</style>
