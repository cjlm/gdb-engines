---
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import RankingTable from '../../components/RankingTable.astro';
import CorrectionNotice from '../../components/CorrectionNotice.astro';
import SponsorCTA from '../../components/SponsorCTA.astro';
import SponsorSlot from '../../components/SponsorSlot.astro';
import BookCredit from '../../components/BookCredit.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { loadRankings, type RankedEngine } from '../../lib/rankings';
import { buildBoards, buildLinkMaps } from '../../lib/ranking-boards';
import { loadSponsors, sponsorFor } from '../../lib/sponsors';
import { buildFaviconMap } from '../../lib/favicon-map';
import { KG_CAPABILITIES, kgCapabilityDescriptions, kgKindLabels, type KgKind } from '../../lib/knowledge-graph';

const ranking = await loadRankings();
if (!ranking) return Astro.redirect('/rankings/');

const databases = await getCollection('databases');
const board = buildBoards(ranking, databases.map(({ data }) => data)).find((b) => b.slug === 'knowledge-graph');
if (!board) return Astro.redirect('/rankings/');

const sponsors = await loadSponsors();
const sponsor = sponsorFor(sponsors, 'ranking-banner');
const headerSponsor = sponsorFor(sponsors, 'header');
const faviconMap = await buildFaviconMap(databases);
const linkMaps = buildLinkMaps(ranking);
const catalogue = new Map(databases.map(({ data }) => [data.slug, data]));
const engineMeta = Object.fromEntries(
  databases.map(({ data }) => [data.slug, { description: data.description ?? '', githubUrl: data.github_url, url: data.url }]),
);

const engines = board.engines;
const kindsOf = (e: RankedEngine): readonly string[] => catalogue.get(e.slug)?.kg_kinds ?? [];
const rolesOf = (e: RankedEngine): readonly string[] => catalogue.get(e.slug)?.ai_roles ?? [];
const capabilitiesOf = (e: RankedEngine): readonly string[] => catalogue.get(e.slug)?.kg_capabilities ?? [];

interface Tab { id: string; label: string; lede: string; engines: RankedEngine[]; more?: { href: string; label: string } }
const kindTab = (kind: KgKind, lede: string): Tab => ({
  id: kind,
  label: kgKindLabels[kind].split(' (')[0],
  lede,
  engines: engines.filter((e) => kindsOf(e).includes(kind)),
});
const tabs: Tab[] = [
  { id: 'all', label: 'All', lede: 'Every engine whose makers present it for knowledge graphs of any kind.', engines },
  kindTab('semantic', 'Engines built around an ontology: mostly RDF stores for controlled vocabularies and linked data, plus a few that reason over ontologies in their own model. The architecture the term originally named.'),
  kindTab('property-graph', 'Labelled property graph databases whose makers present them for knowledge graphs.'),
  kindTab('virtual', 'Engines that present a knowledge graph over data left where it is, in relational databases, warehouses or lakes.'),
  {
    id: 'graphrag',
    label: 'GraphRAG',
    lede: 'Knowledge graph engines also used to ground LLM answers in a graph.',
    engines: engines.filter((e) => rolesOf(e).includes('graphrag')),
    more: { href: '/rankings/graph-databases-graphrag-knowledge-grounding/', label: 'Full GraphRAG ranking' },
  },
  {
    id: 'agent-memory',
    label: 'Agent memory',
    lede: 'Knowledge graph engines also used as memory for AI agents.',
    engines: engines.filter((e) => rolesOf(e).includes('agent-memory')),
    more: { href: '/rankings/graph-databases-agent-memory/', label: 'Full agent memory ranking' },
  },
].filter((t) => t.engines.length > 0);

const top = engines.slice(0, 3);
const updated = new Date(ranking.generatedAt).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
const semanticCount = engines.filter((e) => kindsOf(e).includes('semantic')).length;
const propertyCount = engines.filter((e) => kindsOf(e).includes('property-graph')).length;

const canonical = 'https://gdb-engines.com/rankings/knowledge-graph/';
const itemListJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: board.h1,
  description: board.metaDescription,
  url: canonical,
  numberOfItems: engines.length,
  itemListElement: engines.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://gdb-engines.com/db/${e.slug}/`, name: e.name })),
});
const breadcrumbJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://gdb-engines.com/' },
    { '@type': 'ListItem', position: 2, name: 'Rankings', item: 'https://gdb-engines.com/rankings/' },
    { '@type': 'ListItem', position: 3, name: board.h1, item: canonical },
  ],
});
---
<Layout
  title={`${board.title} — GDB-Engines Rankings`}
  description={board.metaDescription}
  canonical={canonical}
  ogImage="https://gdb-engines.com/og/rankings/knowledge-graph.png"
  jsonLd={[itemListJsonLd, breadcrumbJsonLd]}
>
  <SiteHeader sponsor={headerSponsor} />
  <main class="ranking-page kg-ranking">
    <nav class="breadcrumb"><a href="/rankings/">GDB-Engines Rankings</a> &rsaquo; {board.h1}</nav>
    <h1>{board.h1}</h1>
    <p class="context">
      "Knowledge graph" names several different things: a semantic RDF store with an ontology, a property
      graph a vendor markets for knowledge, a graph view over a warehouse, a graph an LLM extracted from
      documents. This ranking keeps them apart. An engine is listed only where its own makers present it
      for knowledge graphs, and every kind and capability below links to the page that says so.
      <a href="/knowledge-graph/">What the term means, and how to tell them apart &rarr;</a>
    </p>
    {top.length >= 3 && (
      <p class="lead">
        <a href={`/db/${top[0].slug}/`}>{top[0].name}</a> leads with a score of {top[0].score.toFixed(1)}, followed by
        <a href={`/db/${top[1].slug}/`}>{top[1].name}</a> ({top[1].score.toFixed(1)}) and
        <a href={`/db/${top[2].slug}/`}>{top[2].name}</a> ({top[2].score.toFixed(1)}) — {engines.length} engines ranked,
        {semanticCount} semantic and {propertyCount} property graph, {updated}.
      </p>
    )}

    {sponsor ? <SponsorSlot sponsor={sponsor} placement="ranking-banner" /> : <SponsorCTA />}
    <CorrectionNotice />

    <div class="kg-tabs" role="presentation">
      {tabs.map((tab, i) => (
        <input type="radio" name="kg-tab" id={`kg-tab-${tab.id}`} class="kg-tab-input" checked={i === 0} />
      ))}
      <div class="kg-tab-labels" role="tablist">
        {tabs.map((tab) => (
          <label for={`kg-tab-${tab.id}`} class="kg-tab-label" role="tab">{tab.label} <span class="count">{tab.engines.length}</span></label>
        ))}
      </div>
      {tabs.map((tab) => (
        <section class={`kg-tab-panel kg-tab-panel-${tab.id}`} aria-label={tab.label}>
          <h2>{tab.id === 'all' ? 'All knowledge graph engines' : `${tab.label} knowledge graphs`}</h2>
          <p class="tab-lede">{tab.lede}{tab.more && <> <a href={tab.more.href}>{tab.more.label} &rarr;</a></>}</p>
          <RankingTable engines={tab.engines} faviconMap={faviconMap} linkMaps={linkMaps} engineMeta={engineMeta} />
        </section>
      ))}
    </div>

    <section class="kg-capabilities" aria-labelledby="kg-capabilities-heading">
      <h2 id="kg-capabilities-heading">What each engine brings to a knowledge graph</h2>
      <p>
        A database is one part of a knowledge graph, the knowledge base that stores what is known. Jessica
        Talisman's <cite>Ontology Pipeline</cite> sets the rest out: a vocabulary and an ontology are required
        alongside it, and a reasoner, validation, data virtualisation, vector retrieval and graph algorithms are
        optional parts chosen per project. The columns below record which of those parts each engine ships
        itself. A blank means we found no official source for it, not that it can't be added another way.
      </p>
      <div class="ranking-table-wrap">
        <table class="capability-table">
          <thead>
            <tr>
              <th class="num">#</th>
              <th>Engine</th>
              <th>Kind</th>
              {KG_CAPABILITIES.map((c) => <th class="cap" title={kgCapabilityDescriptions[c]}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {engines.map((e, i) => (
              <tr>
                <td class="num">{i + 1}</td>
                <td><a href={`/db/${e.slug}/#sources`}>{e.name}</a></td>
                <td class="kinds">{kindsOf(e).map((k) => kgKindLabels[k as KgKind].split(' (')[0]).join(', ')}</td>
                {KG_CAPABILITIES.map((c) => (
                  <td class="cap">{capabilitiesOf(e).includes(c) ? <span aria-label="Yes" title={c}>&#10003;</span> : <span class="no" aria-label="No source found">·</span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="method">
        Kinds and capabilities are researched per engine from vendor documentation, repositories and papers.
        Each value carries a verbatim quote that is refetched and checked against the cited page before it is
        published; the sources are listed on each engine's page. The order is the monthly
        <a href="/rankings/overall/">popularity score</a>: adoption, activity, community and research signals.
      </p>
    </section>

    <BookCredit />
  </main>
</Layout>

<style>
  .ranking-page { padding: calc(var(--header-height) + 1.5rem) 1.25rem 3rem; }
  .breadcrumb { font-size: 0.85rem; color: var(--color-text-tertiary); margin-bottom: 0.5rem; }
  .breadcrumb a { color: var(--color-text-secondary); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  h1 { font-size: 1.5rem; margin: 0 0 0.5rem; line-height: 1.2; color: var(--color-text); }
  h2 { font-size: 1.15rem; margin: 1.5rem 0 0.4rem; color: var(--color-text); }
  .context, .tab-lede, .kg-capabilities p { color: var(--color-text-secondary); max-width: 90ch; line-height: 1.55; }
  .lead { color: var(--color-text); line-height: 1.55; max-width: 90ch; margin: 0.75rem 0 1.25rem; }
  .context a, .lead a, .tab-lede a, .kg-capabilities a { color: var(--color-text); text-decoration-color: var(--color-border); text-underline-offset: 2px; }

  .kg-tab-input { position: absolute; opacity: 0; pointer-events: none; }
  .kg-tab-labels { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 1.25rem 0 0; border-bottom: 1px solid var(--color-border); }
  .kg-tab-label {
    cursor: pointer; padding: 0.45rem 0.8rem; border: 1px solid var(--color-border); border-bottom: none;
    border-radius: 6px 6px 0 0; font-size: 0.9rem; color: var(--color-text-secondary); background: var(--color-surface);
  }
  .kg-tab-label .count { color: var(--color-text-tertiary); font-size: 0.8rem; }
  .kg-tab-panel { display: none; }
  .kg-tab-panel h2 { margin-top: 1rem; }
  /* One rule per tab: the radio checked first in source order shows its panel and marks its label. */
  #kg-tab-all:checked ~ .kg-tab-panel-all,
  #kg-tab-semantic:checked ~ .kg-tab-panel-semantic,
  #kg-tab-property-graph:checked ~ .kg-tab-panel-property-graph,
  #kg-tab-virtual:checked ~ .kg-tab-panel-virtual,
  #kg-tab-graphrag:checked ~ .kg-tab-panel-graphrag,
  #kg-tab-agent-memory:checked ~ .kg-tab-panel-agent-memory { display: block; }
  #kg-tab-all:checked ~ .kg-tab-labels [for='kg-tab-all'],
  #kg-tab-semantic:checked ~ .kg-tab-labels [for='kg-tab-semantic'],
  #kg-tab-property-graph:checked ~ .kg-tab-labels [for='kg-tab-property-graph'],
  #kg-tab-virtual:checked ~ .kg-tab-labels [for='kg-tab-virtual'],
  #kg-tab-graphrag:checked ~ .kg-tab-labels [for='kg-tab-graphrag'],
  #kg-tab-agent-memory:checked ~ .kg-tab-labels [for='kg-tab-agent-memory'] {
    background: var(--color-background); color: var(--color-text); font-weight: 600;
    margin-bottom: -1px; border-bottom: 1px solid var(--color-background);
  }
  .kg-tab-input:focus-visible ~ .kg-tab-labels { outline: 2px solid var(--color-brand-accent); outline-offset: 2px; }

  .ranking-table-wrap { width: 100%; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .capability-table { width: max-content; min-width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .capability-table th, .capability-table td { padding: 0.35rem 0.55rem; border-bottom: 1px solid var(--color-border); text-align: left; }
  .capability-table th.cap { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-weight: 500; vertical-align: bottom; }
  .capability-table td.cap { text-align: center; }
  .capability-table .no { color: var(--color-text-tertiary); }
  .capability-table .kinds { color: var(--color-text-secondary); white-space: nowrap; }
  .num { text-align: right; font-variant-numeric: tabular-nums; }
  .method { font-size: 0.85rem; }
</style>
