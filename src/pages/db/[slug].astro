---
import Layout from '../../layouts/Layout.astro';
import '../../styles/global.css';
import { getCollection } from 'astro:content';
import { featureGroups, featureDisplayNames, scoreMeanings } from '../../data/feature-metadata';
import { buildFaviconMap } from '../../lib/favicon-map';
import { loadRankings } from '../../lib/rankings';
import { buildBoards, getEngineRanks } from '../../lib/ranking-boards';
import { pregeneratedPairs, buildOverallRankMap, pairSlug, resolveRoundup, MIN_ROUNDUP_MEMBERS } from '../../lib/comparisons';
import { loadGithubStars, formatGithubStars } from '../../lib/github-stars';

const ranking = await loadRankings();
const boards = ranking ? buildBoards(ranking) : [];

export async function getStaticPaths() {
  const databases = await getCollection('databases');
  const rankingFile = await loadRankings();

  // Catalogue-wide facts, resolved once for the whole route rather than per page.
  const pregenerated = pregeneratedPairs(
    rankingFile,
    databases.map((d) => ({ slug: d.data.slug, features: d.data.features }))
  );
  const overallRanks = buildOverallRankMap(rankingFile);
  const rankOrder = [...overallRanks.entries()].sort((x, y) => x[1] - y[1]).map(([slug]) => slug);
  const [faviconMap, githubStars] = await Promise.all([
    buildFaviconMap(databases),
    loadGithubStars(databases),
  ]);

  // §3.6 reverse index: which roundups each engine belongs to, capped at three. Built once
  // here rather than re-resolving every roundup on all 143 engine pages.
  const roundupsByEngine = new Map<string, { slug: string; title: string }[]>();
  for (const entry of await getCollection('roundups')) {
    const resolved = resolveRoundup(entry.data, databases.map((d) => d.data), rankingFile);
    if (resolved.members.length < MIN_ROUNDUP_MEMBERS) continue;
    for (const member of resolved.members) {
      const list = roundupsByEngine.get(member.slug) ?? [];
      if (list.length < 3) list.push({ slug: entry.data.slug, title: entry.data.h1 });
      roundupsByEngine.set(member.slug, list);
    }
  }
  const nameBySlug = new Map(databases.map((d) => [d.data.slug, d.data.name]));
  const languagesBySlug = new Map(databases.map((d) => [d.data.slug, d.data.query_languages ?? []]));

  /** Deterministic peers: nearest-ranked, then sharing a query language, then the top two. */
  function compareLinks(slug: string): { slug: string; name: string; href: string }[] {
    const rank = overallRanks.get(slug);
    const candidates: string[] = [];
    if (rank !== undefined) {
      const i = rank - 1;
      candidates.push(...[rankOrder[i - 2], rankOrder[i - 1], rankOrder[i + 1], rankOrder[i + 2]].filter(Boolean) as string[]);
    }
    const own = languagesBySlug.get(slug) ?? [];
    if (own.length) {
      candidates.push(...rankOrder.filter((s) => (languagesBySlug.get(s) ?? []).some((l) => own.includes(l))).slice(0, 4));
    }
    candidates.push(...rankOrder.slice(0, 2));

    const seen = new Set<string>();
    const links: { slug: string; name: string; href: string }[] = [];
    for (const other of candidates) {
      if (other === slug || seen.has(other)) continue;
      seen.add(other);
      const pair = pairSlug(slug, other);
      if (!pregenerated.has(pair)) continue;
      links.push({ slug: other, name: nameBySlug.get(other) ?? other, href: `/compare/${pair}/` });
      if (links.length === 8) break;
    }
    return links;
  }

  return databases.map(db => ({
    params: { slug: db.data.slug },
    props: {
      db,
      compareLinks: compareLinks(db.data.slug),
      faviconUrl: faviconMap[db.data.slug] ?? null,
      githubStars: githubStars[db.data.slug] ?? null,
      partOf: roundupsByEngine.get(db.data.slug) ?? [],
    },
  }));
}

const { db, compareLinks: comparePeers, faviconUrl, githubStars, partOf } = Astro.props;
const engineRanks = getEngineRanks(boards, db.data.slug);

function formatReleased(value: string): string {
  const match = value.match(/^(\d{4})-(\d{2})$/);
  if (!match) return value;
  const monthName = new Date(`${value}-01T00:00:00Z`).toLocaleString('en-US', { month: 'long', timeZone: 'UTC' });
  return `${monthName} ${match[1]}`;
}


const categoryLabel = `Graph ${db.data.kind === 'database' ? 'Database' : db.data.kind === 'extension' ? 'Database Extension' : db.data.kind === 'query-engine' ? 'Query Engine' : db.data.kind === 'library' ? 'Library' : 'Embedded Database'}`;

const pageJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": db.data.name,
  ...((db.data.url || db.data.github_url) && { "url": db.data.url || db.data.github_url }),
  "description": db.data.description,
  ...(db.data.vendor && {
    "author": {
      "@type": "Organization",
      "name": db.data.vendor,
    }
  }),
  "applicationCategory": categoryLabel,
  ...(db.data.license && db.data.license !== 'Proprietary' && {
    "license": `https://spdx.org/licenses/${db.data.license}`,
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
  }),
  ...(db.data.github_url && { "codeRepository": db.data.github_url }),
  "dateModified": new Date().toISOString().split('T')[0],
});

const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://gdb-engines.com" },
    { "@type": "ListItem", "position": 2, "name": db.data.name, "item": `https://gdb-engines.com/db/${db.data.slug}/` }
  ]
});

const title = `${db.data.name} — ${categoryLabel} | GDB-Engines`;
const description = db.data.description;
---
<Layout
  title={title}
  description={description}
  jsonLd={[pageJsonLd, breadcrumbJsonLd]}
  canonical={`https://gdb-engines.com/db/${db.data.slug}/`}
>
  <main class="db-page">
    <a href="/" class="back-link">&larr; Back to comparison</a>

    <h1>
      {faviconUrl && (
        <img src={faviconUrl} alt="" width="24" height="24" />
      )}
      {db.data.name}
      {(db.data.url || db.data.github_url) && (
        <span class="db-links">
          {db.data.url && (
            <a href={`${db.data.url}${db.data.url.includes('?') ? '&' : '?'}utm_source=gdb-engines&utm_medium=referral`} target="_blank" rel="noopener noreferrer">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20a15.3 15.3 0 0 1 0-20"/></svg>
              Website
            </a>
          )}
          {db.data.github_url && (
            <a
              class="db-github-link"
              href={db.data.github_url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={typeof githubStars === 'number'
                ? `GitHub repository, ${githubStars.toLocaleString('en-US')} stars`
                : 'GitHub repository'}
              title={typeof githubStars === 'number'
                ? `${githubStars.toLocaleString('en-US')} GitHub stars — ${db.data.github_url}`
                : db.data.github_url}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#icon-github" /></svg>
              {typeof githubStars === 'number' ? (
                <span class="github-star-group">
                  <svg class="github-star" width="12" height="12" aria-hidden="true"><use href="#icon-star" /></svg>
                  <span class="github-star-count">{formatGithubStars(githubStars)}</span>
                </span>
              ) : (
                <span>GitHub</span>
              )}
            </a>
          )}
        </span>
      )}
    </h1>

    <p class="description">{db.data.description}</p>

    {(engineRanks.length > 0 || partOf.length > 0) && (
      <section class="ranks-block">
        <h2>Rankings</h2>
        <ul class="ranks-list">
          {engineRanks.map(({ board, rank }) => (
            <li><a href={`/rankings/${board.slug}/`}><span class="rank">#{rank}</span> <span class="label">{board.shortLabel}</span></a></li>
          ))}
          {partOf.map((r) => (
            <li>
              <a class="roundup" href={`/compare/${r.slug}/`}>
                <span class="label">{r.title.replace(/ Compared$/, '')}</span>
                <span class="chev" aria-hidden="true">&rsaquo;</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <h2>Details</h2>
    <dl class="meta-grid">
      {db.data.vendor && (
        <>
          <dt>Vendor</dt>
          <dd>{db.data.vendor}</dd>
        </>
      )}
      <dt>Type</dt>
      <dd>
        <span class={`badge badge-${db.data.type.toLowerCase().replace(/ /g, '-')}`}>
          {db.data.type}
        </span>
      </dd>
      {db.data.kind !== 'database' && (
        <>
          <dt>Kind</dt>
          <dd>
            <span class={`badge badge-${db.data.kind}`}>
              {db.data.kind === 'query-engine' ? 'Query Engine' : db.data.kind === 'extension' ? 'Extension' : db.data.kind === 'library' ? 'Library' : 'Embedded'}
            </span>
          </dd>
        </>
      )}
      <dt>Category</dt>
      <dd>
        <span class={`badge badge-${db.data.category.toLowerCase()}`}>
          {db.data.category}
        </span>
      </dd>
      {db.data.released && (
        <>
          <dt>Released</dt>
          <dd>{formatReleased(db.data.released)}</dd>
        </>
      )}
      {db.data.github_url && (
        <>
          <dt>GitHub</dt>
          <dd>
            <a
              class="github-cell db-github-detail"
              href={db.data.github_url}
              target="_blank"
              rel="noopener noreferrer"
              title={typeof githubStars === 'number'
                ? `${githubStars.toLocaleString('en-US')} GitHub stars — ${db.data.github_url}`
                : db.data.github_url}
            >
              <svg class="github-mark" width="16" height="16" aria-hidden="true"><use href="#icon-github" /></svg>
              <span class="sr-only">GitHub repository</span>
              <span class={`github-star-group ${typeof githubStars === 'number' ? '' : 'github-stars-missing'}`}>
                {typeof githubStars === 'number'
                  ? <svg class="github-star" width="12" height="12" aria-hidden="true"><use href="#icon-star" /></svg>
                  : <span class="github-star-slot" aria-hidden="true" />}
                <span class="github-star-count">{typeof githubStars === 'number' ? formatGithubStars(githubStars) : '—'}</span>
              </span>
            </a>
          </dd>
        </>
      )}
      {db.data.status !== 'active' && (
        <>
          <dt>Status</dt>
          <dd>
            <span class={`badge badge-${db.data.status}`}>
              {db.data.status === 'inactive' ? 'Inactive' : 'Deprecated'}
            </span>
            {db.data.status_note && <span> — {db.data.status_note}</span>}
          </dd>
        </>
      )}
      <dt>License</dt>
      <dd>{db.data.license ?? '-'}</dd>
      {db.data.implementation_language && (
        <>
          <dt>Language</dt>
          <dd>{db.data.implementation_language}</dd>
        </>
      )}
      {db.data.query_languages?.length > 0 && (
        <>
          <dt>Query Languages</dt>
          <dd>{db.data.query_languages.join(', ')}</dd>
        </>
      )}
    </dl>

    {db.data.features && (
      <>
        <h2>Feature Scores</h2>
        {featureGroups.map(group => {
          const groupFeatures = group.features.filter(key => {
            const val = db.data.features?.[key as keyof typeof db.data.features];
            return val !== undefined;
          });
          if (groupFeatures.length === 0) return null;
          return (
            <>
              <h3>{group.name}</h3>
              {groupFeatures.map(key => {
                const value = db.data.features![key as keyof typeof db.data.features] as number;
                const meaning = scoreMeanings[key]?.[String(value)] ?? '';
                return (
                  <div class="feature-row">
                    <span class="feature-name">{featureDisplayNames[key] ?? key}</span>
                    <div class="bar-indicator">
                      <div class="bar-fill" style={`width: ${value * 100}%`} data-score={value}></div>
                    </div>
                    <span class="feature-meaning">{meaning}</span>
                  </div>
                );
              })}
            </>
          );
        })}
      </>
    )}

    {comparePeers.length > 0 && (
      <>
        <h2>Compare with</h2>
        <ul class="compare-with">
          {comparePeers.map((link) => (
            /* The engine name stays in the accessible/crawlable label; the visible
               lozenge drops it because the page is already about this engine. */
            <li><a href={link.href}><span class="sr-only">{db.data.name} </span>vs {link.name}</a></li>
          ))}
        </ul>
      </>
    )}

  </main>
</Layout>
