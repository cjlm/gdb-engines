---
/**
 * `/compare/custom/` — the client-side builder for combinations that were not
 * pre-generated. `noindex, follow`: the long tail still works for a visitor, it just is not
 * published. Without JS the page shows the hub's directory rather than a blank screen.
 */
import Layout from '../../layouts/Layout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import '../../styles/global.css';
---
<Layout
  title="Build a graph database comparison — GDB-Engines"
  description="Compare any two to four graph databases from the catalogue."
  noindex={true}
>
  <SiteHeader />
  <main class="custom-page">
    <h1>Build a comparison</h1>
    <p class="lead">Pick two to four databases. Pairs we publish redirect to their own page.</p>

    <div class="builder" data-compare-builder hidden>
      <div class="combobox-chips" data-combobox-chips></div>
      <label class="visually-hidden" for="compare-combobox">Add a database</label>
      <input
        id="compare-combobox"
        type="text"
        role="combobox"
        autocomplete="off"
        aria-expanded="false"
        aria-controls="compare-listbox"
        aria-autocomplete="list"
        placeholder="Add a database"
        data-combobox-input
      />
      <ul id="compare-listbox" role="listbox" aria-label="Databases" class="combobox-list" data-combobox-list hidden></ul>
      <p class="empty" data-compare-empty>Pick two databases to compare.</p>
      <div data-compare-result></div>
      <div class="visually-hidden" aria-live="polite" data-combobox-live></div>
    </div>

    <p class="fallback">
      Browse the published comparisons on the <a href="/compare/">comparison directory</a>.
    </p>
  </main>
</Layout>

<script>
  import '../../scripts/compare-builder.ts';
</script>

<style>
  .custom-page { padding: calc(var(--header-height) + 1.5rem) 1.25rem 3rem; max-width: 55rem; margin: 0 auto; }
  h1 { font-size: 1.5rem; margin: 0 0 0.5rem; line-height: 1.2; color: var(--color-text); }
  .lead { color: var(--color-text); line-height: 1.55; margin: 0.75rem 0 1.25rem; }
  .builder { position: relative; }
  .fallback { font-size: 0.85rem; color: var(--color-text-secondary); margin-top: 2rem; }
  .fallback a, .empty { color: var(--color-text); }
  .empty { color: var(--color-text-secondary); font-size: 0.9rem; }
  input { width: 100%; max-width: 24rem; padding: 0.45rem 0.6rem; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-bg); color: var(--color-text); font: inherit; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
</style>

<style is:global>
  .combobox-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-bottom: 0.5rem; }
  .combobox-chip { display: inline-flex; align-items: center; gap: 0.35rem; border: 1px solid var(--color-border); border-radius: 999px; padding: 0.15rem 0.5rem; font-size: 0.85rem; }
  .combobox-chip button { background: none; border: 0; color: var(--color-text-tertiary); cursor: pointer; font-size: 1rem; line-height: 1; }
  .combobox-list { list-style: none; margin: 0.25rem 0 0; padding: 0.25rem; max-width: 24rem; max-height: 18rem; overflow-y: auto; border: 1px solid var(--color-border); border-radius: 6px; background: var(--color-surface); position: absolute; z-index: 5; width: 100%; }
  .combobox-option { display: flex; align-items: center; gap: 0.5rem; padding: 0.3rem 0.4rem; border-radius: 4px; cursor: pointer; font-size: 0.9rem; }
  .combobox-option.is-active { background: var(--color-border); }
  .combobox-option[aria-disabled='true'] { color: var(--color-text-tertiary); cursor: default; }
  .combobox-selected { margin-left: auto; font-size: 0.75rem; color: var(--color-text-tertiary); }
  .combobox-monogram { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; border-radius: 3px; background: var(--color-surface); border: 1px solid var(--color-border); font-family: 'Familjen Grotesk', sans-serif; font-weight: 600; font-size: 0.6rem; }
  .combobox-result { list-style: none; padding: 0; margin: 0.75rem 0 0; display: flex; gap: 1rem; flex-wrap: wrap; }
  .compare-table { width: 100%; border-collapse: collapse; margin: 1rem 0 0; font-size: 0.9rem; }
  .compare-table th, .compare-table td { text-align: left; padding: 0.35rem 0.6rem; border-bottom: 1px solid var(--color-border); vertical-align: top; }
  .compare-table thead th { font-weight: 600; color: var(--color-text); }
  .compare-table tbody th[scope='row'] { font-weight: 400; color: var(--color-text-secondary); }
  .compare-table .group-row th { font-weight: 600; color: var(--color-text); padding-top: 1rem; }
  .compare-table tr.differs th[scope='row'] { color: var(--color-text); font-weight: 500; }
  .compare-table .num { font-variant-numeric: tabular-nums; }
  .compare-table .cell-unassessed { color: var(--color-text-tertiary); }
  .compare-table .cell-no { color: var(--color-text-tertiary); }
  .feature-heading { font-size: 1.1rem; margin: 2rem 0 0; color: var(--color-text); }
  .feature-heading .differ-count { font-size: 0.8rem; font-weight: 400; color: var(--color-text-secondary); margin-left: 0.5rem; }
</style>
