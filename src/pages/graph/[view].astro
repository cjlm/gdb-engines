---
import GraphPage from '../graph.astro';
import { GRAPH_VIEWS } from '../../lib/graph-views.mjs';

export function getStaticPaths() {
  return GRAPH_VIEWS.map(({ id }) => ({
    params: { view: id },
    props: { initialView: id },
  }));
}

const { initialView } = Astro.props as { initialView: string };
---

<GraphPage initialView={initialView} />
