---
import GraphPage from '../graph.astro';

type GraphView = 'query-languages' | 'similarity' | 'timeline' | 'lineage';

export function getStaticPaths() {
  return (['query-languages', 'similarity', 'timeline', 'lineage'] as const).map((view) => ({
    params: { view },
    props: { initialView: view },
  }));
}

const { initialView } = Astro.props as { initialView: GraphView };
---

<GraphPage initialView={initialView} />
