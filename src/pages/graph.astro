---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SponsorCTA from '../components/SponsorCTA.astro';
import GraphSwitcher from '../components/graph/GraphSwitcher.astro';
import SimilarityControls from '../components/graph/SimilarityControls.astro';
import QueryLanguagesView from '../components/graph/QueryLanguagesView.astro';
import SimilarityView from '../components/graph/SimilarityView.astro';
import TimelineView from '../components/graph/TimelineView.astro';
import LineageView from '../components/graph/LineageView.astro';
import { getDatabaseCount } from '../lib/database-count';
import { loadSponsors, sponsorFor } from '../lib/sponsors';
import {
  DEFAULT_GRAPH_VIEW,
  graphView,
  graphViewCanonical,
  graphViewPageDescription,
} from '../lib/graph-views.mjs';
import '../styles/global.css';

interface Props {
  initialView?: string;
}

const initialView = Astro.props.initialView ?? DEFAULT_GRAPH_VIEW;
const currentView = graphView(initialView);
const headerSponsor = sponsorFor(await loadSponsors(), 'header');
const databaseCount = await getDatabaseCount();
const garphieldOrigin = import.meta.env.PUBLIC_GARPHIELD_ORIGIN ?? 'https://garphield.com';
---
<Layout
  title={currentView.title}
  description={graphViewPageDescription(currentView, databaseCount)}
  canonical={graphViewCanonical(initialView)}
>
  <SiteHeader sponsor={headerSponsor} />

  <main
    class="graph-page"
    data-garphield-origin={garphieldOrigin}
    data-initial-view={initialView}
  >
    <section class="graph-intro">
      <div class="graph-heading">
        <h1>Graph Database Map</h1>
        <p id="model-description">{currentView.modelDescription}</p>
      </div>
      <div class="graph-sponsor"><SponsorCTA compact /></div>
    </section>

    <section class="graph-stage" aria-label="Interactive graph visualization">
      <div class="graph-status-row">
        <div class="graph-status-left">
          <GraphSwitcher activeView={initialView} databaseCount={databaseCount} />
          <SimilarityControls />
        </div>
        <div class="graph-status-right">
          <p id="graph-selection" aria-live="polite" hidden></p>
          <p id="graph-status" role="status">Starting visualization…</p>
        </div>
      </div>
      <div class="visualization-views">
        <QueryLanguagesView />
        <SimilarityView />
        <TimelineView />
        <LineageView />
      </div>
    </section>

    <p class="graph-credit">
      Network graphs drawn with
      <a href={`${garphieldOrigin}/`}>Garphield</a>, a free network visualization tool.
    </p>

    <noscript>
      <p class="graph-fallback">
        JavaScript is required for the interactive view. The underlying
        <a href="/graphs/databases-languages.gfd">query-language graph</a> and
        <a href="/graphs/databases-similarity.gfd">similarity graph</a> are
        available as structured Garphield documents.
      </p>
    </noscript>
  </main>

  {/* After the views' own scripts, so every view has registered before the first switch. */}
  <script>
    import { startGraphShell } from '../components/graph/graph-shell';

    startGraphShell();
  </script>

  <style>
    .graph-page {
      min-height: 100vh;
      padding: calc(var(--header-height) + 1.5rem) 0 1.25rem;
      display: grid;
      grid-template-rows: auto minmax(34rem, 1fr) auto;
      gap: 0;
    }

    .graph-intro {
      width: min(calc(100% - 2.5rem), 92rem);
      margin: 0 auto;
      padding-bottom: 1rem;
      display: grid;
      grid-template-columns: minmax(15rem, 0.6fr) minmax(0, 1.4fr);
      align-items: center;
      gap: clamp(1.25rem, 3vw, 2.5rem);
    }

    .graph-heading {
      min-width: 0;
    }

    .graph-intro h1 {
      font-size: 1.5rem;
      color: var(--color-text);
      margin: 0;
    }

    #model-description {
      height: 3.1em;
      margin: 0.35rem 0 0;
      overflow: hidden;
      color: var(--color-text);
      line-height: 1.55;
    }

    .graph-intro :global(.sponsor-cta) {
      max-width: none;
      margin: 0;
    }

    .graph-stage {
      width: min(calc(100% - 2.5rem), 92rem);
      min-height: 34rem;
      margin: 0 auto;
      display: grid;
      grid-template-rows: auto minmax(0, 1fr);
      overflow: hidden;
      border: 1px solid var(--color-border);
      border-radius: 0.75rem;
      background: var(--color-background);
      box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.08);
    }

    .graph-stage.timeline-active {
      min-height: 38rem;
    }

    .graph-status-row {
      min-height: 2.75rem;
      padding: 0.6rem 0.85rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 1px solid var(--color-border);
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .graph-status-left {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .graph-status-right {
      min-width: 0;
      margin-left: auto;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
    }

    #graph-status,
    #graph-selection {
      margin: 0;
    }

    #graph-selection {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      white-space: nowrap;
    }

    #graph-selection[hidden] {
      display: none;
    }

    #graph-selection :global(.selection-detail) {
      color: var(--color-text-secondary);
    }

    .visualization-views {
      position: relative;
      width: 100%;
      height: 100%;
      min-height: 31rem;
      background: var(--color-background);
    }

    .graph-credit {
      width: min(calc(100% - 2.5rem), 92rem);
      margin: 0.6rem auto 0;
      color: var(--color-text-secondary);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-align: right;
    }

    .graph-credit a {
      color: inherit;
      text-decoration: underline;
      text-underline-offset: 0.15em;
    }

    .graph-credit a:hover {
      color: var(--color-text);
    }

    .graph-fallback {
      width: min(calc(100% - 2.5rem), 92rem);
      margin: 0 auto;
      padding: 1rem;
      border: 1px solid var(--color-border);
    }

    @media (max-width: 48rem) {
      .graph-page {
        padding: calc(var(--header-height) + 1.25rem) 0 1rem;
        grid-template-rows: auto auto auto;
        align-content: start;
        gap: 1rem;
      }

      .graph-intro {
        display: contents;
      }

      .graph-heading,
      .graph-sponsor {
        width: calc(100% - 2rem);
        margin-inline: auto;
      }

      .graph-heading {
        order: 0;
      }

      .graph-sponsor {
        order: 2;
      }

      .graph-intro h1 {
        margin-bottom: 0.35rem;
        font-size: 1.5rem;
        line-height: 1.2;
      }

      /* Two lines for every view's summary, so switching views does not move the stage. */
      #model-description {
        height: auto;
        min-height: 2lh;
        margin: 0;
        font-size: 0.875rem;
        color: var(--color-text-secondary);
        overflow: visible;
      }

      .graph-stage,
      .graph-credit,
      .graph-fallback {
        width: calc(100% - 2rem);
        min-width: 0;
        order: 1;
      }

      .graph-credit {
        margin-top: -0.4rem;
        text-align: left;
      }

      .graph-stage {
        min-height: 28rem;
        box-shadow: none;
      }

      .graph-stage:not(.lineage-active):not(.timeline-active) {
        height: 70svh;
      }

      .visualization-views {
        min-height: 0;
      }

      .graph-status-row {
        padding: 0.6rem;
        align-items: flex-start;
        flex-direction: column;
        gap: 0.65rem;
      }

      .graph-status-left {
        width: 100%;
        flex-wrap: wrap;
        gap: 0.75rem;
      }

      .graph-status-right {
        width: 100%;
        margin-left: 0;
        align-items: flex-start;
        flex-direction: column;
        gap: 0.3rem;
        padding-inline: 0.25rem;
        overflow-wrap: anywhere;
      }

      /* Room for a wrapped status line on both Garphield views, so the graph keeps its size. */
      .graph-stage:not([data-view-kind='page']) #graph-status {
        min-height: 2lh;
      }

      #graph-selection {
        flex-wrap: wrap;
        white-space: normal;
      }

      .graph-stage.timeline-active {
        min-height: 0;
      }

      .graph-stage.lineage-active,
      .graph-stage.timeline-active {
        display: block;
        min-height: 0;
        overflow: visible;
      }

      .lineage-active .graph-status-row,
      .timeline-active .graph-status-row {
        position: sticky;
        top: var(--header-height);
        z-index: 5;
        background: var(--color-background);
        border-radius: 0.75rem 0.75rem 0 0;
      }

      .lineage-active .visualization-views,
      .timeline-active .visualization-views {
        height: auto;
        border-radius: 0 0 0.75rem 0.75rem;
      }
    }
  </style>

  <style is:global>
    /*
     * Every view stays mounted in .visualization-views. The incoming view fades in above the
     * outgoing one, which stays fully drawn underneath until the fade ends, so a switch never
     * shows an empty stage.
     */
    .visualization-view {
      --graph-view-fade: 160ms;
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      background: var(--color-background);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition:
        opacity 0s linear var(--graph-view-fade),
        visibility 0s linear var(--graph-view-fade);
    }

    .visualization-view.ready.active {
      z-index: 1;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transition: opacity var(--graph-view-fade) ease;
    }

    /*
     * A covered embed keeps painting (an invisible cross-origin frame would be throttled), so it
     * shows its current selection, filter, camera and theme the moment it comes back. Hidden
     * frames are inert and aria-hidden.
     */
    .garphield-frame.visualization-view:not(.active) {
      visibility: visible;
    }

    .visualization-views.instant .visualization-view,
    .visualization-views.instant .visualization-view.ready.active {
      transition: none;
    }

    @media (prefers-reduced-motion: reduce) {
      .visualization-view,
      .visualization-view.ready.active {
        transition: none;
      }
    }
  </style>
</Layout>
