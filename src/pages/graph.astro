---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SponsorCTA from '../components/SponsorCTA.astro';
import { getDatabaseCount } from '../lib/database-count';
import { buildFaviconMap } from '../lib/favicon-map';
import { getCollection } from 'astro:content';
import '../styles/global.css';

type GraphView = 'query-languages' | 'similarity' | 'timeline';

interface Props {
  initialView?: GraphView;
}

const initialView = Astro.props.initialView ?? 'query-languages';
const viewMetadata: Record<
  GraphView,
  { title: string; description: string; modelDescription: string; canonical: string }
> = {
  'query-languages': {
    title: 'Graph database query language map — GDB-Engines',
    description: 'Explore graph databases through the query languages they support.',
    modelDescription: 'Databases linked via query languages supported.',
    canonical: 'https://gdb-engines.com/graph/query-languages/',
  },
  similarity: {
    title: 'Graph database similarity map — GDB-Engines',
    description: 'Explore graph databases linked to their nearest catalogue peers.',
    modelDescription:
      'Link each database to its nearest catalog peers using type, kind, category, license, implementation language, and query languages.',
    canonical: 'https://gdb-engines.com/graph/similarity/',
  },
  timeline: {
    title: 'Graph database product timeline — GDB-Engines',
    description:
      'Explore when products in the graph database catalogue were first publicly released.',
    modelDescription:
      'See when each catalogued database product was first released. Some added graph capabilities later.',
    canonical: 'https://gdb-engines.com/graph/timeline/',
  },
};
const currentView = viewMetadata[initialView];

const databaseCount = await getDatabaseCount();
const garphieldOrigin =
  import.meta.env.PUBLIC_GARPHIELD_ORIGIN ?? 'https://garphield.com';

const databaseEntries = await getCollection('databases');
const faviconMap = await buildFaviconMap(databaseEntries);
const timelineDatabases = databaseEntries.map(({ data }) => ({
  name: data.name,
  slug: data.slug,
  released: data.released ?? null,
  type: data.type,
  logo: faviconMap[data.slug] ?? null,
  initial: data.name.match(/[\p{L}\p{N}]/u)?.[0]?.toLocaleUpperCase() ?? '?',
}));
const datedDatabases = timelineDatabases.filter(
  (database): database is typeof database & { released: string } =>
    database.released !== null,
);
const undatedDatabases = timelineDatabases
  .filter((database) => database.released === null)
  .sort((left, right) => left.name.localeCompare(right.name));
const timelineStartYear = Math.min(
  ...datedDatabases.map((database) => Number(database.released.slice(0, 4))),
);
const timelineEndYear = Math.max(
  ...datedDatabases.map((database) => Number(database.released.slice(0, 4))),
);
const timelineYears = Array.from(
  { length: timelineEndYear - timelineStartYear + 1 },
  (_, index) => timelineEndYear - index,
);
const timelineYearHeight = 96;
const timelineAxisTop = 48;
const positionedDatabases = datedDatabases
  .map((database) => {
    const [year, month] = database.released.split('-').map(Number);
    const yearFraction = month ? (month - 0.5) / 12 : 0.5;
    return {
      ...database,
      chronologicalOffset: year - timelineStartYear + yearFraction,
      top:
        timelineAxisTop +
        (timelineEndYear - year + 1 - yearFraction) * timelineYearHeight,
      releaseLabel: month
        ? new Date(`${database.released}-01T00:00:00Z`).toLocaleString('en-US', {
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })
        : database.released,
    };
  })
  .sort(
    (left, right) =>
      right.chronologicalOffset - left.chronologicalOffset ||
      left.name.localeCompare(right.name),
  );
const timelineAxisHeight = timelineYears.length * timelineYearHeight;
const timelineUnknownTop = timelineAxisTop + timelineAxisHeight + 36;
const timelineUndatedNodeTop = timelineUnknownTop + 42;
const timelineCanvasHeight =
  timelineUnknownTop + (undatedDatabases.length > 0 ? 90 : 32);

function timelineTypeClass(type: string): string {
  if (type === 'Property Graph') return 'property';
  if (type === 'RDF') return 'rdf';
  if (type === 'Multiple') return 'multiple';
  return 'other';
}
---
<Layout
  title={currentView.title}
  description={`${currentView.description} Compare ${databaseCount} graph databases.`}
  canonical={currentView.canonical}
>
  <SiteHeader />

  <main
    class="graph-page"
    data-garphield-origin={garphieldOrigin}
    data-initial-view={initialView}
  >
    <section class="graph-intro">
      <div class="graph-heading">
        <h1>Graph Database Map</h1>
        <p id="model-description">{currentView.modelDescription}</p>
      </div>
      <SponsorCTA />
    </section>

    <section class="graph-stage" aria-label="Interactive graph visualization">
      <div class="graph-status-row">
        <div class="graph-status-left">
          <nav class="model-switcher" aria-label="Graph views">
            <a
              href="/graph/query-languages/"
              class:list={[
                'model-button',
                initialView === 'query-languages' && 'active',
              ]}
              data-view="query-languages"
              data-document="/graphs/databases-languages.gfd"
              data-description="Databases linked via query languages supported."
              data-mobile-description="Databases linked via query languages supported."
              data-page-title={viewMetadata['query-languages'].title}
              data-page-description={`${viewMetadata['query-languages'].description} Compare ${databaseCount} graph databases.`}
              data-canonical={viewMetadata['query-languages'].canonical}
              aria-current={initialView === 'query-languages' ? 'page' : undefined}
            >
              Query languages
            </a>
            <a
              href="/graph/similarity/"
              class:list={[
                'model-button',
                initialView === 'similarity' && 'active',
              ]}
              data-view="similarity"
              data-document="/graphs/databases-similarity.gfd"
              data-description="Link each database to its nearest catalog peers using type, kind, category, license, implementation language, and query languages."
              data-mobile-description="Databases linked to their nearest catalog peers."
              data-page-title={viewMetadata.similarity.title}
              data-page-description={`${viewMetadata.similarity.description} Compare ${databaseCount} graph databases.`}
              data-canonical={viewMetadata.similarity.canonical}
              aria-current={initialView === 'similarity' ? 'page' : undefined}
            >
              Similarity
            </a>
            <a
              href="/graph/timeline/"
              class:list={[
                'model-button',
                initialView === 'timeline' && 'active',
              ]}
              data-view="timeline"
              data-description="See when each catalogued database product was first released. Some added graph capabilities later."
              data-mobile-description="A timeline of graph database product releases, from the newest products back to the earliest."
              data-page-title={viewMetadata.timeline.title}
              data-page-description={`${viewMetadata.timeline.description} Compare ${databaseCount} graph databases.`}
              data-canonical={viewMetadata.timeline.canonical}
              aria-current={initialView === 'timeline' ? 'page' : undefined}
            >
              Timeline
            </a>
          </nav>
          <div id="similarity-control" hidden>
            <label class="similarity-threshold-control">
              <span>Min similarity</span>
              <input
                id="similarity-threshold"
                type="range"
                min="0.2"
                max="0.8"
                value="0.2"
                step="0.05"
              />
              <output id="similarity-value" for="similarity-threshold">≥ 20%</output>
            </label>
          </div>
        </div>
        <div class="graph-status-right">
          <p id="graph-selection" aria-live="polite" hidden></p>
          <p id="graph-status" role="status">Starting visualization…</p>
        </div>
      </div>
      <div class="visualization-views">
        <iframe
          class="garphield-frame visualization-view active"
          data-document="/graphs/databases-languages.gfd"
          title="Graph databases linked by query language"
          loading="eager"
          aria-hidden="false"
        ></iframe>
        <iframe
          class="garphield-frame visualization-view"
          data-document="/graphs/databases-similarity.gfd"
          title="Graph databases linked by catalog similarity"
          loading="eager"
          aria-hidden="true"
          tabindex="-1"
        ></iframe>
        <section
          id="release-timeline"
          class="timeline-view visualization-view"
          aria-label="Graph database product release timeline"
          aria-hidden="true"
          data-dated-count={positionedDatabases.length}
          data-undated-count={undatedDatabases.length}
          data-start-year={timelineStartYear}
          data-end-year={timelineEndYear}
          style={`--timeline-canvas-height: ${timelineCanvasHeight}px`}
        >
          <div
            class="timeline-scroll"
            tabindex="-1"
            aria-label={`Release timeline from ${timelineEndYear} back to ${timelineStartYear}. Newest releases are at the top.`}
          >
            <div class="timeline-canvas">
              <div class="timeline-axis" aria-hidden="true">
                <span
                  class="timeline-axis-line"
                  style={`--axis-top: ${timelineAxisTop}px; --axis-height: ${timelineAxisHeight}px`}
                ></span>
                {timelineYears.map((year, index) => {
                  const major =
                    year === timelineEndYear ||
                    year === timelineStartYear ||
                    year % 5 === 0;
                  return (
                    <span
                      class:list={[
                        'timeline-year-tick',
                        major && 'major',
                        year === timelineEndYear && 'latest',
                      ]}
                      style={`--year-top: ${timelineAxisTop + index * timelineYearHeight}px`}
                    >
                      <span>
                        {year}
                      </span>
                    </span>
                  );
                })}
                {undatedDatabases.length > 0 && (
                  <span
                    class="timeline-unknown-label"
                    style={`--unknown-top: ${timelineUnknownTop}px`}
                  >
                    Unknown date
                  </span>
                )}
              </div>
              <ol class="timeline-nodes">
                {positionedDatabases.map((database) => (
                  <li
                    class="timeline-item"
                    data-timeline-y={database.top}
                    style={`--release-top: ${database.top}px`}
                  >
                    <a
                      href={`/db/${database.slug}/`}
                      class:list={[
                        'timeline-node',
                        `timeline-node--${timelineTypeClass(database.type)}`,
                      ]}
                      aria-label={`${database.name}, original product first released ${database.releaseLabel}`}
                      data-slug={database.slug}
                    >
                      {database.logo ? (
                        <img
                          src={database.logo}
                          alt=""
                          width="24"
                          height="24"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="timeline-node-placeholder" aria-hidden="true">
                          {database.initial}
                        </span>
                      )}
                    </a>
                    <span class="timeline-node-label" aria-hidden="true">
                      <span class="timeline-node-label-name">{database.name}</span>
                      <small class="timeline-node-label-date">{database.releaseLabel}</small>
                    </span>
                  </li>
                ))}
                {undatedDatabases.map((database, index) => (
                  <li
                    class="timeline-item timeline-undated-node"
                    data-timeline-y={timelineUndatedNodeTop}
                    data-timeline-order={index}
                    style={`--release-top: ${timelineUndatedNodeTop}px`}
                  >
                    <a
                      href={`/db/${database.slug}/`}
                      class:list={[
                        'timeline-node',
                        `timeline-node--${timelineTypeClass(database.type)}`,
                      ]}
                      aria-label={`${database.name}, release date unconfirmed`}
                      data-slug={database.slug}
                    >
                      {database.logo ? (
                        <img
                          src={database.logo}
                          alt=""
                          width="24"
                          height="24"
                          loading="lazy"
                          decoding="async"
                        />
                      ) : (
                        <span class="timeline-node-placeholder" aria-hidden="true">
                          {database.initial}
                        </span>
                      )}
                    </a>
                    <span class="timeline-node-label" aria-hidden="true">
                      <span class="timeline-node-label-name">{database.name}</span>
                      <small class="timeline-node-label-date">Release date unknown</small>
                    </span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
          <div class="timeline-key" aria-label="Graph model colors">
            <span><i class="property"></i>Property graph</span>
            <span><i class="rdf"></i>RDF</span>
            <span><i class="multiple"></i>Multiple</span>
            <span><i class="other"></i>Other</span>
          </div>
        </section>
      </div>
    </section>

    <noscript>
      <p class="graph-fallback">
        JavaScript is required for the interactive view. The underlying
        <a href="/graphs/databases-languages.gfd">query-language graph</a> and
        <a href="/graphs/databases-similarity.gfd">similarity graph</a> are
        available as structured Garphield documents.
      </p>
    </noscript>
  </main>

  <script>
    import { createGarphield } from 'garphield';

    const page = document.querySelector('.graph-page');
    const graphStage = document.querySelector('.graph-stage');
    const frames = [
      ...document.querySelectorAll<HTMLIFrameElement>('.garphield-frame'),
    ];
    const timeline = document.querySelector('#release-timeline');
    const timelineScroll = document.querySelector('.timeline-scroll');
    const timelineCanvas = document.querySelector('.timeline-canvas');
    const timelineKey = document.querySelector('.timeline-key');
    const graphStatusRow = document.querySelector('.graph-status-row');
    const timelineNodes = [
      ...document.querySelectorAll<HTMLAnchorElement>('.timeline-node'),
    ];
    const timelineItems = [
      ...document.querySelectorAll<HTMLLIElement>('.timeline-item'),
    ];
    const status = document.querySelector('#graph-status');
    const selection = document.querySelector('#graph-selection');
    const description = document.querySelector('#model-description');
    const similarityControl = document.querySelector('#similarity-control');
    const similarityThreshold = document.querySelector('#similarity-threshold');
    const similarityValue = document.querySelector('#similarity-value');
    const buttons = [
      ...document.querySelectorAll<HTMLAnchorElement>('.model-button'),
    ];

    if (
      page instanceof HTMLElement &&
      graphStage instanceof HTMLElement &&
      frames.length === 2 &&
      timeline instanceof HTMLElement &&
      timelineScroll instanceof HTMLElement &&
      timelineCanvas instanceof HTMLElement &&
      timelineKey instanceof HTMLElement &&
      graphStatusRow instanceof HTMLElement &&
      status instanceof HTMLElement &&
      selection instanceof HTMLElement &&
      description instanceof HTMLElement &&
      similarityControl instanceof HTMLElement &&
      similarityThreshold instanceof HTMLInputElement &&
      similarityValue instanceof HTMLOutputElement
    ) {
      const origin = page.dataset.garphieldOrigin ?? 'https://garphield.com';
      const initialButton =
        buttons.find((button) => button.dataset.view === page.dataset.initialView) ??
        buttons[0];
      const contexts = new Map(
        frames.map((frame) => {
          const driver = createGarphield(frame, {
            embedUrl: new URL('/embed', origin),
            timeoutMs: 30_000,
          });
          return [
            frame.dataset.document ?? '',
            {
              frame,
              driver,
              ready: driver.ready(),
              nodes: new Map(),
              loaded: false,
            },
          ];
        }),
      );
      let activeDocument = null;
      let activeButton = null;
      let activeContext = contexts.get(
        initialButton?.dataset.document ?? '',
      );
      let hasRendered = false;
      let loadVersion = 0;
      let similarityFilterFrame = 0;
      let similarityFilterVersion = 0;
      let timelineLayoutFrame = 0;
      const imageLoads = new Map<string, Promise<void>>();

      function syncTimelineStageHeight() {
        if (!graphStage.classList.contains('timeline-active')) return;
        const horizontalScrollbarHeight =
          timelineScroll.offsetHeight - timelineScroll.clientHeight;
        graphStage.style.height = `${
          graphStatusRow.offsetHeight +
          timelineCanvas.offsetHeight +
          timelineKey.offsetHeight +
          horizontalScrollbarHeight +
          2
        }px`;
      }

      const timelineStageObserver = new ResizeObserver(
        syncTimelineStageHeight,
      );
      timelineStageObserver.observe(graphStatusRow);
      timelineStageObserver.observe(timelineKey);

      function beeswarmPositions(
        nodeSize: number,
        canvasWidth: number,
      ): number[] | null {
        const radius = nodeSize / 2;
        const minimumDistance = nodeSize + 5;
        const minimumDistanceSquared = minimumDistance ** 2;
        const centerClearance = radius + 30;
        const maximumOffset = canvasWidth / 2 - radius - 10;
        if (centerClearance > maximumOffset) return null;

        const placed: Array<{ x: number; y: number }> = [];
        for (const [index, item] of timelineItems.entries()) {
          const y = Number(item.dataset.timelineY ?? 0);
          const nearby = placed.filter(
            (point) => Math.abs(y - point.y) < minimumDistance,
          );
          const candidates = [centerClearance, -centerClearance];
          for (const point of nearby) {
            const deltaY = y - point.y;
            const tangentX = Math.sqrt(
              Math.max(0, minimumDistanceSquared - deltaY ** 2),
            );
            candidates.push(point.x - tangentX, point.x + tangentX);
          }

          const preferredSign = index % 2 === 0 ? 1 : -1;
          candidates.sort((left, right) => {
            const distance = Math.abs(left) - Math.abs(right);
            if (Math.abs(distance) > 0.01) return distance;
            const leftPreferred = Math.sign(left) === preferredSign;
            const rightPreferred = Math.sign(right) === preferredSign;
            return Number(rightPreferred) - Number(leftPreferred);
          });

          const x = candidates.find((candidate) => {
            if (
              Math.abs(candidate) < centerClearance - 0.01 ||
              Math.abs(candidate) > maximumOffset + 0.01
            ) {
              return false;
            }
            return nearby.every((point) => {
              const deltaX = candidate - point.x;
              const deltaY = y - point.y;
              return deltaX ** 2 + deltaY ** 2 >= minimumDistanceSquared - 0.1;
            });
          });
          if (x === undefined) return null;
          placed.push({ x, y });
        }
        return placed.map((point) => point.x);
      }

      function rectanglesOverlap(left: DOMRect, right: DOMRect): boolean {
        return !(
          left.right + 3 <= right.left ||
          left.left >= right.right + 3 ||
          left.bottom + 3 <= right.top ||
          left.top >= right.bottom + 3
        );
      }

      function revealTimelineLabels() {
        const canvasRect = timelineCanvas.getBoundingClientRect();
        const yearLabelRects = [
          ...timelineCanvas.querySelectorAll<HTMLElement>(
            '.timeline-year-tick > span, .timeline-unknown-label',
          ),
        ].map((label) => label.getBoundingClientRect());
        const nodeRects = timelineNodes.map((node) => node.getBoundingClientRect());
        const visibleLabelRects: DOMRect[] = [];

        for (const [index, item] of timelineItems.entries()) {
          item.classList.remove('timeline-item--label-visible');
          const label = item.querySelector<HTMLElement>('.timeline-node-label');
          if (!label) continue;
          const isRight = item.classList.contains('timeline-item--right');
          const positions = isRight
            ? [
                'right',
                'right-up',
                'right-down',
                'above-right',
                'below-right',
                'above',
                'below',
                'left',
              ]
            : [
                'left',
                'left-up',
                'left-down',
                'above-left',
                'below-left',
                'above',
                'below',
                'right',
              ];
          let placed = false;
          for (const position of positions) {
            label.dataset.position = position;
            const labelRect = label.getBoundingClientRect();
            const insideCanvas =
              labelRect.left >= canvasRect.left + 6 &&
              labelRect.right <= canvasRect.right - 6 &&
              labelRect.top >= canvasRect.top + 6 &&
              labelRect.bottom <= canvasRect.bottom - 6;
            const touchesYear = yearLabelRects.some((rect) =>
              rectanglesOverlap(labelRect, rect),
            );
            const touchesNode = nodeRects.some(
              (rect, nodeIndex) =>
                nodeIndex !== index && rectanglesOverlap(labelRect, rect),
            );
            const touchesLabel = visibleLabelRects.some((rect) =>
              rectanglesOverlap(labelRect, rect),
            );
            if (insideCanvas && !touchesYear && !touchesNode && !touchesLabel) {
              item.classList.add('timeline-item--label-visible');
              visibleLabelRects.push(labelRect);
              placed = true;
              break;
            }
          }
          if (!placed) label.dataset.position = isRight ? 'right' : 'left';
        }
        timeline.dataset.visibleLabels = String(visibleLabelRects.length);
      }

      function layoutTimeline() {
        if (timelineItems.length === 0 || timelineCanvas.clientWidth === 0) return;
        const maximumNodeSize = 40;
        let nodeSize = Math.min(
          maximumNodeSize,
          Math.floor(timelineCanvas.clientWidth / 5),
        );
        let positions: number[] | null = null;
        for (; nodeSize >= 18; nodeSize -= 2) {
          positions = beeswarmPositions(nodeSize, timelineCanvas.clientWidth);
          if (positions) break;
        }
        if (!positions) return;

        timeline.style.setProperty('--timeline-node-size', `${nodeSize}px`);
        timeline.dataset.nodeSize = String(nodeSize);
        for (const [index, item] of timelineItems.entries()) {
          const x = positions[index];
          item.style.left = `calc(50% + ${x.toFixed(2)}px)`;
          item.classList.toggle('timeline-item--right', x >= 0);
          item.classList.toggle('timeline-item--left', x < 0);
        }
        revealTimelineLabels();
        syncTimelineStageHeight();
      }

      function scheduleTimelineLayout() {
        if (timelineLayoutFrame !== 0) return;
        timelineLayoutFrame = requestAnimationFrame(() => {
          timelineLayoutFrame = 0;
          layoutTimeline();
        });
      }

      const timelineLayoutObserver = new ResizeObserver(scheduleTimelineLayout);
      timelineLayoutObserver.observe(timelineCanvas);

      function preloadImage(url: string): Promise<void> {
        const existing = imageLoads.get(url);
        if (existing) return existing;

        const pending = new Promise<void>((resolve) => {
          const image = new Image();
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timeout);
            resolve();
          };
          const timeout = window.setTimeout(finish, 8_000);
          image.crossOrigin = 'anonymous';
          image.decoding = 'async';
          image.onerror = finish;
          image.onload = () => {
            void image.decode().catch(() => undefined).then(finish);
          };
          image.src = url;
        });
        imageLoads.set(url, pending);
        return pending;
      }

      async function preloadNodeImages(document) {
        const urls = [
          ...new Set(
            document.datasets[0].graph.nodes
              .map((node) => node.image)
              .filter((image): image is string => typeof image === 'string'),
          ),
        ];
        await Promise.all(urls.map(preloadImage));
      }

      function clearSelection() {
        selection.replaceChildren();
        selection.hidden = true;
      }

      function showSelection({ label, imageUrl, href, detail = '' }) {
        const content = document.createDocumentFragment();
        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = '';
          image.width = 18;
          image.height = 18;
          content.append(image);
        }
        if (href) {
          const link = document.createElement('a');
          link.href = href;
          link.textContent = label;
          content.append(link);
        } else {
          const text = document.createElement('span');
          text.textContent = label;
          content.append(text);
        }
        if (detail) {
          const metadata = document.createElement('span');
          metadata.className = 'selection-detail';
          metadata.textContent = `· ${detail}`;
          content.append(metadata);
        }
        selection.replaceChildren(content);
        selection.hidden = false;
      }

      for (const context of contexts.values()) {
        context.driver.on('nodeClick', (payload) => {
          if (context !== activeContext) return;
          if (!payload.nodeId) {
            clearSelection();
            return;
          }
          const node = context.nodes.get(payload.nodeId);
          if (!node) {
            clearSelection();
            return;
          }

          const label = String(node.label ?? node.id);
          const isDatabase = String(node.id).startsWith('db:');
          showSelection({
            label,
            imageUrl: typeof node.image === 'string' ? node.image : '',
            href: isDatabase
              ? `/db/${encodeURIComponent(String(node.id).slice(3))}/`
              : '',
          });
        });
        context.driver.on('error', (payload) => {
          if (context === activeContext) {
            status.textContent = `Visualization error: ${payload.message}`;
          }
        });
      }

      const colorScheme = window.matchMedia('(prefers-color-scheme: dark)');
      const compactLayout = window.matchMedia('(max-width: 48rem)');

      function effectiveTheme(): 'light' | 'dark' {
        const explicit = document.documentElement.dataset.theme;
        if (explicit === 'light' || explicit === 'dark') return explicit;
        return colorScheme.matches ? 'dark' : 'light';
      }

      async function syncContextTheme(context) {
        await context.ready;
        await context.driver.setTheme({ colorScheme: effectiveTheme() });
      }

      async function syncTheme() {
        await Promise.all([...contexts.values()].map(syncContextTheme));
      }

      function reportThemeError(error: unknown) {
        status.textContent = `Could not match visualization theme: ${String(error)}`;
      }

      const themeObserver = new MutationObserver(() => {
        void syncTheme().catch(reportThemeError);
      });
      themeObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme'],
      });
      const systemThemeListener = () => {
        if (!document.documentElement.dataset.theme) {
          void syncTheme().catch(reportThemeError);
        }
      };
      colorScheme.addEventListener('change', systemThemeListener);

      function updateSimilarityLabel() {
        similarityValue.value = `≥ ${Math.round(Number(similarityThreshold.value) * 100)}%`;
      }

      function updateDescription() {
        if (!activeButton) return;
        description.textContent =
          (compactLayout.matches
            ? activeButton.dataset.mobileDescription
            : activeButton.dataset.description) ?? '';
      }

      function updatePageMetadata() {
        if (!activeButton) return;
        const title = activeButton.dataset.pageTitle;
        const pageDescription = activeButton.dataset.pageDescription;
        const canonical = activeButton.dataset.canonical;
        if (title) {
          document.title = title;
          document
            .querySelector('meta[property="og:title"]')
            ?.setAttribute('content', title);
          document
            .querySelector('meta[name="twitter:title"]')
            ?.setAttribute('content', title);
        }
        if (pageDescription) {
          document
            .querySelector('meta[name="description"]')
            ?.setAttribute('content', pageDescription);
          document
            .querySelector('meta[property="og:description"]')
            ?.setAttribute('content', pageDescription);
          document
            .querySelector('meta[name="twitter:description"]')
            ?.setAttribute('content', pageDescription);
        }
        if (canonical) {
          document
            .querySelector('link[rel="canonical"]')
            ?.setAttribute('href', canonical);
          document
            .querySelector('meta[property="og:url"]')
            ?.setAttribute('content', canonical);
        }
      }

      function updateGraphStatus(graph, visibleLinks = graph.links.length) {
        const databaseCount = graph.nodes.filter((node) =>
          String(node.id).startsWith('db:'),
        ).length;
        if (activeButton?.dataset.document?.includes('similarity')) {
          status.textContent = `${databaseCount} databases · ${visibleLinks} similar database pairs`;
          return;
        }
        const queryLanguageCount = graph.nodes.length - databaseCount;
        status.textContent = `${databaseCount} databases · ${queryLanguageCount} query languages · ${visibleLinks} supported database–language pairings`;
      }

      async function applySimilarityFilter() {
        if (
          !activeDocument ||
          !activeButton?.dataset.document?.includes('similarity')
        ) {
          return;
        }
        const version = ++similarityFilterVersion;
        const threshold = Number(similarityThreshold.value);
        const graph = activeDocument.datasets[0].graph;
        const visibleLinks = graph.links.filter(
          (link) =>
            typeof link.similarity === 'number' &&
            link.similarity >= threshold,
        ).length;
        updateGraphStatus(graph, visibleLinks);
        try {
          await activeContext?.driver.call('setEdgeFilter', {
            field: 'similarity',
            min: threshold,
          });
        } catch (error) {
          if (version !== similarityFilterVersion) return;
          status.textContent = `Could not filter similarity relationships: ${String(error)}`;
        }
      }

      function scheduleSimilarityFilter() {
        if (similarityFilterFrame !== 0) return;
        similarityFilterFrame = requestAnimationFrame(() => {
          similarityFilterFrame = 0;
          void applySimilarityFilter();
        });
      }

      function hideRenderedView(): Promise<void> {
        if (!hasRendered) return Promise.resolve();

        const activeView =
          activeButton?.dataset.view === 'timeline'
            ? timeline
            : activeContext?.frame;
        if (!activeView) return Promise.resolve();

        graphStage.classList.add('switching');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          return Promise.resolve();
        }

        return new Promise((resolve) => {
          let settled = false;
          const finish = () => {
            if (settled) return;
            settled = true;
            window.clearTimeout(timeout);
            activeView.removeEventListener(
              'transitionend',
              handleTransitionEnd,
            );
            resolve();
          };
          const handleTransitionEnd = (event: TransitionEvent) => {
            if (event.propertyName === 'opacity') finish();
          };
          const timeout = window.setTimeout(finish, 240);
          activeView.addEventListener('transitionend', handleTransitionEnd);
        });
      }

      async function waitForGraphPaint() {
        await new Promise((resolve) =>
          requestAnimationFrame(() => requestAnimationFrame(resolve)),
        );
        // The embed replies after accepting a document. Give its canvas one
        // extra beat to paint before the host starts revealing it.
        await new Promise((resolve) => window.setTimeout(resolve, 100));
      }

      async function renderDocument(source, version, graphHidden, context) {
        const document = structuredClone(source);
        const graph = document.datasets[0].graph;

        if (!context.loaded) {
          await syncContextTheme(context);
          await context.driver.setDocument(document);
          context.nodes = new Map(
            graph.nodes.map((node) => [String(node.id), node]),
          );
          context.loaded = true;
          await waitForGraphPaint();
          context.frame.classList.add('ready');
        }

        await graphHidden;
        if (version !== loadVersion) return;

        for (const candidate of contexts.values()) {
          const active = candidate === context;
          candidate.frame.classList.toggle('active', active);
          candidate.frame.setAttribute('aria-hidden', String(!active));
          if (active) {
            candidate.frame.removeAttribute('tabindex');
          } else {
            candidate.frame.tabIndex = -1;
          }
        }
        timeline.classList.remove('active');
        timeline.setAttribute('aria-hidden', 'true');
        timelineScroll.tabIndex = -1;
        activeContext = context;
        updateGraphStatus(graph);
        graphStage.style.removeProperty('height');
        graphStage.classList.remove('timeline-active');
        graphStage.classList.add('ready');
        graphStage.classList.remove('switching');
        graphStage.removeAttribute('aria-busy');
        hasRendered = true;
      }

      async function renderTimeline(version, viewHidden) {
        await viewHidden;
        if (version !== loadVersion) return;

        for (const context of contexts.values()) {
          context.frame.classList.remove('active');
          context.frame.setAttribute('aria-hidden', 'true');
          context.frame.tabIndex = -1;
        }
        timeline.classList.add('ready', 'active');
        timeline.setAttribute('aria-hidden', 'false');
        timelineScroll.tabIndex = -1;
        activeContext = null;
        activeDocument = null;
        const undatedCount = Number(timeline.dataset.undatedCount ?? 0);
        status.textContent = `${timeline.dataset.startYear}–${timeline.dataset.endYear}${undatedCount ? ` · ${undatedCount} unconfirmed` : ''}`;
        graphStage.classList.add('ready', 'timeline-active');
        graphStage.classList.remove('switching');
        graphStage.removeAttribute('aria-busy');
        hasRendered = true;

        scheduleTimelineLayout();
        requestAnimationFrame(syncTimelineStageHeight);
      }

      async function loadView(button) {
        if (button === activeButton && hasRendered) return;

        const version = ++loadVersion;
        const viewHidden = hideRenderedView();
        graphStage.setAttribute('aria-busy', 'true');
        activeButton = button;
        for (const candidate of buttons) {
          const active = candidate === button;
          candidate.classList.toggle('active', active);
          if (active) {
            candidate.setAttribute('aria-current', 'page');
          } else {
            candidate.removeAttribute('aria-current');
          }
        }
        updateDescription();
        updatePageMetadata();
        similarityControl.hidden =
          !button.dataset.document?.includes('similarity');
        clearSelection();
        status.textContent = 'Loading…';

        if (button.dataset.view === 'timeline') {
          await renderTimeline(version, viewHidden);
          return;
        }

        try {
          const response = await fetch(button.dataset.document);
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const document = await response.json();
          // Generated documents keep production-absolute asset URLs so they
          // remain portable. In dev, point those same assets at this local GDB
          // server; Garphield still receives a valid absolute URL.
          if (import.meta.env.DEV) {
            for (const node of document.datasets[0].graph.nodes) {
              if (typeof node.image !== 'string') continue;
              const image = new URL(node.image);
              if (image.origin === 'https://gdb-engines.com') {
                node.image = new URL(image.pathname, window.location.origin).href;
              }
            }
          }
          if (version !== loadVersion) return;
          activeDocument = document;
          await preloadNodeImages(document);
          if (version !== loadVersion) return;
          const context = contexts.get(button.dataset.document ?? '');
          if (!context) throw new Error('No visualization frame for model');
          await renderDocument(document, version, viewHidden, context);
          await applySimilarityFilter();
        } catch (error) {
          if (version !== loadVersion) return;
          graphStage.classList.remove('switching');
          graphStage.removeAttribute('aria-busy');
          status.textContent = `Could not load visualization: ${String(error)}`;
        }
      }

      updateSimilarityLabel();
      compactLayout.addEventListener('change', updateDescription);
      window.addEventListener('resize', syncTimelineStageHeight);
      similarityThreshold.addEventListener('input', () => {
        updateSimilarityLabel();
        scheduleSimilarityFilter();
      });

      function buttonForPath(pathname: string) {
        return (
          buttons.find((button) => new URL(button.href).pathname === pathname) ??
          buttons[0]
        );
      }

      function handlePopState() {
        const button = buttonForPath(window.location.pathname);
        if (button) void loadView(button);
      }

      for (const button of buttons) {
        button.addEventListener('click', (event) => {
          if (
            event.button !== 0 ||
            event.metaKey ||
            event.ctrlKey ||
            event.shiftKey ||
            event.altKey
          ) {
            return;
          }
          event.preventDefault();
          const nextUrl = new URL(button.href);
          if (nextUrl.pathname !== window.location.pathname) {
            window.history.pushState({}, '', nextUrl.pathname);
          }
          void loadView(button);
        });
      }
      window.addEventListener('popstate', handlePopState);
      if (initialButton) void loadView(initialButton);
      window.addEventListener(
        'pagehide',
        () => {
          themeObserver.disconnect();
          colorScheme.removeEventListener('change', systemThemeListener);
          compactLayout.removeEventListener('change', updateDescription);
          window.removeEventListener('resize', syncTimelineStageHeight);
          window.removeEventListener('popstate', handlePopState);
          timelineStageObserver.disconnect();
          timelineLayoutObserver.disconnect();
          if (similarityFilterFrame !== 0) {
            cancelAnimationFrame(similarityFilterFrame);
          }
          if (timelineLayoutFrame !== 0) {
            cancelAnimationFrame(timelineLayoutFrame);
          }
          for (const context of contexts.values()) {
            context.driver.destroy();
          }
        },
        { once: true },
      );
    }
  </script>

