---
interface Props {
  src: string;
  size?: number;
  loading?: 'eager' | 'lazy';
}

const { src, size = 16, loading } = Astro.props;
---
<span class="database-logo" style={`--database-logo-size: ${size}px`} aria-hidden="true">
  <img
    src={src}
    alt=""
    width={size}
    height={size}
    loading={loading}
    decoding="async"
  />
</span>
