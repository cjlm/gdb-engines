---
/**
 * Small multiples of how often Emil Eifrem's talks mention a set of terms, pooled by half-year.
 * Rendered through EifremOntology.astro and EifremAudiences.astro, which pick the terms.
 */
import { loadBlogData } from '../../lib/blog-data';
import {
  FIRST_YEAR,
  LAST_YEAR,
  PERIODS,
  maxRate,
  poolByHalfYear,
  type Talk,
  type TermChartConfig,
} from '../../lib/relate-charts';

interface Props {
  config: TermChartConfig;
  label: string;
  caption: string;
}

const { config, label, caption } = Astro.props;
const { talks } = loadBlogData<{ talks: Talk[] }>('eifrem-talks');
const pooled = poolByHalfYear(talks, config.series);
const scaleMax = maxRate(pooled, config.series);
const formatRate = (rate: number) => rate.toFixed(1);
const step = 100 / PERIODS.length;
const barX = (index: number) => index * step + step * 0.15;
const barWidth = step * 0.7;
const tooltip = (period: (typeof pooled)[number], rate: number) =>
  `${period.period}: ${formatRate(rate)} per 1,000 words, ` +
  `${period.talks.length} ${period.talks.length === 1 ? 'talk' : 'talks'}`;
const tipSide = (index: number) =>
  index < 3 ? 'top-right' : index > PERIODS.length - 4 ? 'top-left' : 'top';
const years = Array.from({ length: LAST_YEAR - FIRST_YEAR + 1 }, (_, i) => FIRST_YEAR + i);
const sampled = pooled.filter((period) => period.talks.length > 0).length;
---
<figure class="eifrem-terms">
  <div class="eifrem-rows" role="group" aria-label={label}>
    {config.series.map((series) => (
      <div class="eifrem-row">
        <div class="eifrem-row-name">{series.name}</div>
        <div class="eifrem-plot">
          <span class="eifrem-baseline" aria-hidden="true"></span>
          {pooled.map((period, index) => {
            const rate = period.rates[series.key];
            if (rate === null || rate === undefined) return null;
            const noteIndex = config.notes.findIndex((n) => n.key === series.key && n.period === period.period);
            const note = noteIndex >= 0;
            return (
              <>
                <span
                  class:list={['eifrem-bar', note && 'is-noted']}
                  style={`left: ${barX(index)}%; width: ${barWidth}%; height: ${scaleMax ? (rate / scaleMax) * 100 : 0}%`}
                  tabindex="0"
                  role="tooltip"
                  aria-label={tooltip(period, rate)}
                  data-microtip-position={tipSide(index)}
                  data-microtip-size="medium"
                ></span>
                {note && (
                  <span
                    class="eifrem-note-marker"
                    style={`left: ${barX(index) + barWidth / 2}%; bottom: calc(${scaleMax ? (rate / scaleMax) * 100 : 0}% + 0.3rem)`}
                    aria-hidden="true"
                  >{noteIndex + 1}</span>
                )}
              </>
            );
          })}
        </div>
      </div>
    ))}
    <div class="eifrem-row" aria-hidden="true">
      <span></span>
      <div class="eifrem-xaxis">
        {years.map((year, i) => (i % 2 === 0 || year === LAST_YEAR) && (
          <span style={`left: ${i * 2 * step}%`}>{year}</span>
        ))}
      </div>
    </div>
  </div>
  {config.notes.length > 0 && (
    <ol class="eifrem-notes">
      {config.notes.map((note) => (
        <li>{note.text}</li>
      ))}
    </ol>
  )}
  <figcaption>
    {caption} Mentions per 1,000 caption words, pooled across the talks in each half-year, with
    every row on the same scale (tallest bar {formatRate(scaleMax)}). {talks.length} YouTube talks
    from {FIRST_YEAR} to {LAST_YEAR}, from auto-captions, cover {sampled} of the {PERIODS.length}
    half-years; blank half-years had no talks sampled. Panels and interviews include other
    speakers, so their counts are not Emil's alone.
  </figcaption>
  <details class="eifrem-data">
    <summary>Data table</summary>
    <div class="eifrem-table">
      <table>
        <thead>
          <tr>
            <th scope="col">Half-year</th>
            <th scope="col" class="is-number">Talks</th>
            <th scope="col" class="is-number">Words</th>
            {config.series.map((series) => <th scope="col" class="is-number">{series.name}</th>)}
          </tr>
        </thead>
        <tbody>
          {pooled.filter((period) => period.talks.length > 0).map((period) => (
            <tr>
              <th scope="row">{period.period}</th>
              <td class="is-number">{period.talks.length}</td>
              <td class="is-number">{period.words.toLocaleString('en-US')}</td>
              {config.series.map((series) => (
                <td class="is-number">{formatRate(period.rates[series.key] ?? 0)}</td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .eifrem-terms {
    margin: 2.5rem 0;
  }

  .eifrem-row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: end;
    margin-bottom: 0.75rem;
  }

  .eifrem-row-name {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.3;
    padding-bottom: 0.1rem;
  }

  .eifrem-plot {
    position: relative;
    height: 3.25rem;
    margin-right: 0.5rem;
  }

  .eifrem-baseline {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    border-bottom: 1px solid var(--color-border);
  }

  /* Outranks microtip's [aria-label][role~='tooltip'] { position: relative }. */
  .eifrem-plot .eifrem-bar[role~='tooltip'] {
    position: absolute;
    bottom: 0;
    min-height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--color-brand-accent);
    cursor: default;
  }

  .eifrem-plot .eifrem-bar.is-noted[role~='tooltip'] {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-text);
  }

  .eifrem-plot .eifrem-bar[role~='tooltip']:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }

  .eifrem-note-marker {
    position: absolute;
    transform: translateX(-50%);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  .eifrem-notes {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .eifrem-xaxis {
    position: relative;
    height: 1.25rem;
    margin-right: 0.5rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .eifrem-xaxis span {
    position: absolute;
  }

  .eifrem-terms figcaption {
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .eifrem-data {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .eifrem-data summary {
    color: var(--color-text-tertiary);
    cursor: pointer;
  }

  .eifrem-table {
    overflow-x: auto;
  }

  .eifrem-table table {
    margin-top: 0.75rem;
  }

  .eifrem-table .is-number {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
