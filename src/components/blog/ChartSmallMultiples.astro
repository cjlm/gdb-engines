---
/** Rows of bars sharing one scale and one set of slots; a row name labels each row. */
import { barHeight, slot, tipSide, type SmallMultiplesSpec } from '../../lib/blog-charts';

interface Props {
  spec: SmallMultiplesSpec;
}

const { spec } = Astro.props;
---
<div class="chart-sm" role="group" aria-label={spec.ariaLabel}>
  {spec.rows.map((row) => (
    <div class="chart-sm-row">
      <div class="chart-sm-name">{row.name}</div>
      <div class="chart-sm-plot">
        {row.bars.map((bar) => {
          const { left, width } = slot(bar.index, spec.columns);
          const height = barHeight(bar.value, spec.max);
          return (
            <>
              <span
                class:list={['chart-sm-bar', bar.marker && 'is-marked']}
                style={`left: ${left}%; width: ${width}%; height: ${height}%`}
                tabindex="0"
                role="tooltip"
                aria-label={bar.tooltip}
                data-microtip-position={tipSide(left)}
                data-microtip-size="medium"
              ></span>
              {bar.marker && (
                <span
                  class="chart-sm-marker"
                  style={`left: ${left + width / 2}%; bottom: calc(${height}% + 0.3rem)`}
                  aria-hidden="true"
                >{bar.marker}</span>
              )}
            </>
          );
        })}
      </div>
    </div>
  ))}
  <div class="chart-sm-row" aria-hidden="true">
    <span></span>
    <div class="chart-sm-xaxis">
      {spec.xLabels.map((label) => <span style={`left: ${slot(label.index, spec.columns).left}%`}>{label.label}</span>)}
    </div>
  </div>
</div>

<style>
  .chart-sm-row {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: end;
    margin-bottom: 0.75rem;
  }

  .chart-sm-name {
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.3;
    padding-bottom: 0.1rem;
  }

  .chart-sm-plot {
    position: relative;
    height: 3.25rem;
    margin-right: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  /* Outranks microtip's [aria-label][role~='tooltip'] { position: relative }. */
  .chart-sm-plot .chart-sm-bar[role~='tooltip'] {
    position: absolute;
    bottom: 0;
    min-height: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--color-brand-accent);
    cursor: default;
  }

  .chart-sm-plot .chart-sm-bar.is-marked[role~='tooltip'] {
    box-shadow: 0 0 0 2px var(--color-background), 0 0 0 3px var(--color-text);
  }

  .chart-sm-plot .chart-sm-bar[role~='tooltip']:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }

  .chart-sm-marker {
    position: absolute;
    transform: translateX(-50%);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1;
  }

  .chart-sm-xaxis {
    position: relative;
    height: 1.25rem;
    margin-right: 0.5rem;
    color: var(--color-text-tertiary);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .chart-sm-xaxis span {
    position: absolute;
  }
</style>
