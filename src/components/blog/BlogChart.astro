---
/**
 * A chart placed in a blog post by <figure data-chart="id"></figure>. Loads the synced spec and
 * draws it with the generic renderer for its type; caption, notes and data table come from the
 * spec too.
 */
import { loadChartSpec } from '../../lib/blog-charts';
import ChartECharts from './ChartECharts.astro';
import ChartEmbed from './ChartEmbed.astro';
import ChartGarphield from './ChartGarphield.astro';

interface Props {
  id: string;
}

const spec = loadChartSpec(Astro.props.id);
---
<figure class="blog-chart">
  {spec.type === 'echarts' && <ChartECharts spec={spec} />}
  {spec.type === 'embed' && <ChartEmbed spec={spec} />}
  {spec.type === 'garphield' && <ChartGarphield spec={spec} />}
  {spec.legend && spec.legend.length > 0 && (
    <ul class="blog-chart-legend">
      {spec.legend.map((item) => (
        <li>
          {(item.sizes ?? [10]).map((size) => (
            <i
              class:list={['blog-chart-swatch', item.ring && 'is-ring']}
              style={`--swatch: var(--chart-${item.color}); --swatch-size: ${size}px; opacity: ${item.opacity ?? 1}`}
            ></i>
          ))}
          {item.label}
        </li>
      ))}
    </ul>
  )}
  {spec.notes && spec.notes.length > 0 && (
    <ol class="blog-chart-notes">
      {spec.notes.map((note) => <li>{note}</li>)}
    </ol>
  )}
  <figcaption>{spec.caption}</figcaption>
  {spec.table && (
    <details class="blog-chart-data">
      <summary>Data table</summary>
      <div class="blog-chart-table">
        <table>
          <thead>
            <tr>
              {spec.table.columns.map((column) => (
                <th scope="col" class:list={[column.numeric && 'is-number']}>{column.label}</th>
              ))}
            </tr>
          </thead>
          <tbody>
            {spec.table.rows.map((row) => (
              <tr>
                {row.map((cell, index) =>
                  index === 0 ? (
                    <th scope="row">{cell}</th>
                  ) : (
                    <td class:list={[spec.table?.columns[index]?.numeric && 'is-number']}>{cell}</td>
                  ),
                )}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </details>
  )}
</figure>

<style>
  /* Chart colours, read by src/lib/echarts-mount.ts as "token:<name>". */
  .blog-chart {
    --chart-bg: var(--color-background);
    --chart-ink: var(--color-text);
    --chart-ink2: var(--color-text-secondary);
    --chart-ink3: var(--color-text-tertiary);
    --chart-rule: var(--color-border);
    --chart-grid: #ececec;
    --chart-accent: var(--color-brand-accent);
    --chart-c1: var(--color-brand-accent);
    --chart-c2: var(--color-text-secondary);
    margin: 2.5rem 0;
  }

  @media (prefers-color-scheme: dark) {
    :root:not([data-theme='light']) .blog-chart {
      --chart-grid: #2c2c2c;
    }
  }

  :root[data-theme='dark'] .blog-chart {
    --chart-grid: #2c2c2c;
  }

  .blog-chart-legend {
    margin: 0.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.1rem;
    list-style: none;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.4;
  }

  .blog-chart-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }

  .blog-chart-swatch {
    width: var(--swatch-size);
    height: var(--swatch-size);
    flex: none;
    border-radius: 50%;
    background: var(--swatch);
  }

  .blog-chart-swatch.is-ring {
    box-shadow: 0 0 0 1.5px var(--chart-ink);
  }

  .blog-chart-notes {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
    color: var(--color-text-secondary);
    font-size: 0.8125rem;
    line-height: 1.5;
  }

  .blog-chart figcaption {
    margin-top: 1rem;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .blog-chart-data {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
  }

  .blog-chart-data summary {
    color: var(--color-text-tertiary);
    cursor: pointer;
  }

  .blog-chart-table {
    overflow-x: auto;
  }

  .blog-chart-table table {
    margin-top: 0.75rem;
  }

  .blog-chart-table .is-number {
    font-variant-numeric: tabular-nums;
    text-align: right;
  }
</style>
