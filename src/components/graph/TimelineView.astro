---
import { getCollection } from 'astro:content';
import { buildFaviconMap } from '../../lib/favicon-map';
import { yearsDescending } from '../../lib/timeline-beeswarm.mjs';

const databaseEntries = await getCollection('databases');
const faviconMap = await buildFaviconMap(databaseEntries);
const timelineDatabases = databaseEntries.map(({ data }) => ({
  name: data.name,
  slug: data.slug,
  released: data.released ?? null,
  type: data.type,
  logo: faviconMap[data.slug] ?? null,
  initial: data.name.match(/[\p{L}\p{N}]/u)?.[0]?.toLocaleUpperCase() ?? '?',
}));
const datedDatabases = timelineDatabases.filter(
  (database): database is typeof database & { released: string } => database.released !== null,
);
const undatedDatabases = timelineDatabases
  .filter((database) => database.released === null)
  .toSorted((left, right) => left.name.localeCompare(right.name));
const releaseYears = datedDatabases.map((database) => Number(database.released.slice(0, 4)));
const startYear = Math.min(...releaseYears);
const endYear = Math.max(...releaseYears);
const years = yearsDescending(startYear, endYear);
const yearHeight = 96;
const axisTop = 48;
const positionedDatabases = datedDatabases
  .map((database) => {
    const [year, month] = database.released.split('-').map(Number);
    const yearFraction = month ? (month - 0.5) / 12 : 0.5;
    return {
      ...database,
      chronologicalOffset: year - startYear + yearFraction,
      top: axisTop + (endYear - year + 1 - yearFraction) * yearHeight,
      releaseLabel: month
        ? new Date(`${database.released}-01T00:00:00Z`).toLocaleString('en-US', {
            month: 'long',
            year: 'numeric',
            timeZone: 'UTC',
          })
        : database.released,
    };
  })
  .toSorted(
    (left, right) =>
      right.chronologicalOffset - left.chronologicalOffset || left.name.localeCompare(right.name),
  );
const axisHeight = years.length * yearHeight;
const unknownTop = axisTop + axisHeight + 36;
const undatedNodeTop = unknownTop + 42;
const canvasHeight = unknownTop + (undatedDatabases.length > 0 ? 90 : 32);

function typeClass(type: string): string {
  if (type === 'Property Graph') return 'property';
  if (type === 'RDF') return 'rdf';
  if (type === 'Multiple') return 'multiple';
  return 'other';
}
---

<section
  id="release-timeline"
  class="timeline-view visualization-view"
  data-graph-view="timeline"
  aria-label="Graph database product release timeline"
  aria-hidden="true"
  data-dated-count={positionedDatabases.length}
  data-undated-count={undatedDatabases.length}
  data-start-year={startYear}
  data-end-year={endYear}
  style={`--timeline-canvas-height: ${canvasHeight}px`}
>
  <p class="timeline-mobile-hint">
    Busy years expand to fit. Tap a node for details; tap again to open.
  </p>
  <div
    class="timeline-scroll"
    tabindex="-1"
    aria-label={`Release timeline from ${endYear} back to ${startYear}. ` +
      'Newest releases are at the top.'}
  >
    <div class="timeline-canvas">
      <div class="timeline-axis" aria-hidden="true">
        <span
          class="timeline-axis-line"
          style={`--axis-top: ${axisTop}px; --axis-height: ${axisHeight}px`}
        ></span>
        {years.map((year, index) => {
          const major = year === endYear || year === startYear || year % 5 === 0;
          return (
            <span
              class:list={['timeline-year-tick', major && 'major', year === endYear && 'latest']}
              style={`--year-top: ${axisTop + index * yearHeight}px`}
            >
              <span>{year}</span>
            </span>
          );
        })}
        {undatedDatabases.length > 0 && (
          <span class="timeline-unknown-label" style={`--unknown-top: ${unknownTop}px`}>
            Unknown date
          </span>
        )}
      </div>
      <ol class="timeline-nodes">
        {positionedDatabases.map((database) => (
          <li
            class="timeline-item"
            data-timeline-y={database.top}
            data-release={database.released}
            style={`--release-top: ${database.top}px`}
          >
            <a
              href={`/db/${database.slug}/`}
              class:list={['timeline-node', `timeline-node--${typeClass(database.type)}`]}
              aria-label={`${database.name}, original product first released ` +
                database.releaseLabel}
              data-slug={database.slug}
            >
              {database.logo ? (
                <img
                  src={database.logo}
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="timeline-node-placeholder" aria-hidden="true">
                  {database.initial}
                </span>
              )}
            </a>
            <span class="timeline-node-label" aria-hidden="true">
              <span class="timeline-node-label-name">{database.name}</span>
              <small class="timeline-node-label-date">{database.releaseLabel}</small>
            </span>
          </li>
        ))}
        {undatedDatabases.map((database, index) => (
          <li
            class="timeline-item timeline-undated-node"
            data-timeline-y={undatedNodeTop}
            data-timeline-order={index}
            style={`--release-top: ${undatedNodeTop}px`}
          >
            <a
              href={`/db/${database.slug}/`}
              class:list={['timeline-node', `timeline-node--${typeClass(database.type)}`]}
              aria-label={`${database.name}, release date unconfirmed`}
              data-slug={database.slug}
            >
              {database.logo ? (
                <img
                  src={database.logo}
                  alt=""
                  width="24"
                  height="24"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="timeline-node-placeholder" aria-hidden="true">
                  {database.initial}
                </span>
              )}
            </a>
            <span class="timeline-node-label" aria-hidden="true">
              <span class="timeline-node-label-name">{database.name}</span>
              <small class="timeline-node-label-date">Release date unknown</small>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
  <div class="timeline-key" aria-label="Graph model colors">
    <span><i class="property"></i>Property graph</span>
    <span><i class="rdf"></i>RDF</span>
    <span><i class="multiple"></i>Multiple</span>
    <span><i class="other"></i>Other</span>
  </div>
</section>

<script>
  import { mountTimelineView } from './timeline-view';

  const timeline = document.querySelector('#release-timeline');
  if (!(timeline instanceof HTMLElement)) {
    throw new Error('Timeline view: #release-timeline is missing from the page.');
  }
  mountTimelineView(timeline);
</script>

<style>
  .timeline-view {
    --timeline-property: #b34862;
    --timeline-rdf: #3975bd;
    --timeline-multiple: #7860ba;
    --timeline-other: #a96b16;
    --timeline-node-size: 1.75rem;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    overflow: hidden;
  }

  .timeline-mobile-hint {
    display: none;
  }

  .timeline-scroll {
    min-width: 0;
    min-height: 0;
    overflow: visible;
  }

  .timeline-canvas {
    position: relative;
    width: 100%;
    height: var(--timeline-canvas-height);
  }

  .timeline-axis {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  .timeline-axis-line {
    position: absolute;
    top: var(--axis-top);
    left: 50%;
    height: var(--axis-height);
    border-left: 1px solid var(--color-text-tertiary);
  }

  .timeline-axis-line::before {
    content: '';
    position: absolute;
    top: -0.4rem;
    left: -0.28rem;
    width: 0;
    height: 0;
    border-right: 0.28rem solid transparent;
    border-bottom: 0.42rem solid var(--color-text-tertiary);
    border-left: 0.28rem solid transparent;
  }

  .timeline-year-tick {
    position: absolute;
    top: var(--year-top);
    left: 50%;
    width: 2.7rem;
    border-top: 1px solid var(--color-border);
    transform: translateX(-50%);
  }

  .timeline-year-tick.major {
    width: 3rem;
  }

  .timeline-year-tick > span,
  .timeline-unknown-label {
    position: absolute;
    top: 0;
    left: 50%;
    padding: 0.18rem 0.38rem;
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    background: var(--color-background);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    transform: translate(-50%, -50%);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }

  .timeline-year-tick.latest > span {
    padding: 0.28rem 0.45rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border-color: var(--color-brand);
    background: var(--color-brand);
    color: white;
    box-shadow: 0 2px 8px color-mix(in srgb, var(--color-brand) 24%, transparent);
  }

  .timeline-unknown-label {
    top: var(--unknown-top);
    white-space: nowrap;
  }

  .timeline-nodes {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline-nodes li {
    position: absolute;
    top: var(--release-top);
    left: 50%;
    z-index: 1;
    width: var(--timeline-node-size);
    height: var(--timeline-node-size);
    transform: translate(-50%, -50%);
  }

  .timeline-nodes li.timeline-item--label-visible {
    z-index: 4;
  }

  .timeline-nodes li.timeline-item:hover,
  .timeline-nodes li.timeline-item:focus-within {
    z-index: 10;
  }

  .timeline-node {
    width: 100%;
    height: 100%;
    padding: 1px;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 2px solid var(--timeline-node-color);
    border-radius: 50%;
    background: white;
    box-shadow: 0 2px 6px rgb(0 0 0 / 0.16);
    cursor: pointer;
    text-decoration: none;
    transition:
      transform 120ms ease,
      box-shadow 120ms ease;
  }

  .timeline-node-label {
    position: absolute;
    z-index: 2;
    max-width: min(13rem, 32vw);
    overflow: hidden;
    padding: 0.24rem 0.42rem;
    border: 1px solid var(--color-border);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--color-background) 94%, transparent);
    color: var(--color-text);
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.11);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 650;
    line-height: 1.15;
    text-overflow: ellipsis;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 100ms ease;
  }

  .timeline-node-label-name {
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .timeline-node-label-date {
    display: none;
    margin-top: 0.16rem;
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    line-height: 1.15;
  }

  .timeline-node-label[data-position='right'] {
    top: 50%;
    left: calc(100% + 0.45rem);
    transform: translateY(-50%);
  }

  .timeline-node-label[data-position='left'] {
    top: 50%;
    right: calc(100% + 0.45rem);
    transform: translateY(-50%);
  }

  .timeline-node-label[data-position='right-up'] {
    right: auto;
    bottom: 50%;
    left: calc(100% + 0.45rem);
  }

  .timeline-node-label[data-position='right-down'] {
    top: 50%;
    right: auto;
    left: calc(100% + 0.45rem);
  }

  .timeline-node-label[data-position='left-up'] {
    right: calc(100% + 0.45rem);
    bottom: 50%;
    left: auto;
  }

  .timeline-node-label[data-position='left-down'] {
    top: 50%;
    right: calc(100% + 0.45rem);
    left: auto;
  }

  .timeline-node-label[data-position='above'],
  .timeline-node-label[data-position='above-left'],
  .timeline-node-label[data-position='above-right'] {
    top: auto;
    bottom: calc(100% + 0.35rem);
  }

  .timeline-node-label[data-position='below'],
  .timeline-node-label[data-position='below-left'],
  .timeline-node-label[data-position='below-right'] {
    top: calc(100% + 0.35rem);
    bottom: auto;
  }

  .timeline-node-label[data-position='above'],
  .timeline-node-label[data-position='below'] {
    left: 50%;
    transform: translateX(-50%);
  }

  .timeline-node-label[data-position='above-left'],
  .timeline-node-label[data-position='below-left'] {
    right: 50%;
    left: auto;
  }

  .timeline-node-label[data-position='above-right'],
  .timeline-node-label[data-position='below-right'] {
    right: auto;
    left: 50%;
  }

  .timeline-item--label-visible .timeline-node-label,
  .timeline-item:hover .timeline-node-label,
  .timeline-item:focus-within .timeline-node-label {
    z-index: 11;
    opacity: 1;
    visibility: visible;
  }

  .timeline-item:hover .timeline-node-label-date,
  .timeline-item:focus-within .timeline-node-label-date {
    display: block;
  }

  .timeline-node:hover,
  .timeline-node:focus-visible {
    position: relative;
    z-index: 2;
    transform: scale(1.3);
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--timeline-node-color) 24%, transparent),
      0 4px 12px rgb(0 0 0 / 0.2);
    outline: none;
  }

  .timeline-node img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: contain;
  }

  .timeline-node-placeholder {
    color: var(--timeline-node-color);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 700;
    line-height: 1;
  }

  .timeline-node--property,
  .timeline-key i.property {
    --timeline-node-color: var(--timeline-property);
  }

  .timeline-node--rdf,
  .timeline-key i.rdf {
    --timeline-node-color: var(--timeline-rdf);
  }

  .timeline-node--multiple,
  .timeline-key i.multiple {
    --timeline-node-color: var(--timeline-multiple);
  }

  .timeline-node--other,
  .timeline-key i.other {
    --timeline-node-color: var(--timeline-other);
  }

  .timeline-key {
    min-height: 2.55rem;
    padding: 0.55rem 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.45rem 0.9rem;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .timeline-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.32rem;
    white-space: nowrap;
  }

  .timeline-key i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 50%;
    background: var(--timeline-node-color);
  }

  @media (max-width: 48rem) {
    .timeline-view.active {
      position: relative;
      height: auto;
      overflow: visible;
      display: block;
      padding: 0;
      border-radius: inherit;
    }

    .timeline-mobile-hint {
      display: block;
      width: 100%;
      padding: 0.65rem 0.85rem 0;
      color: var(--color-text-secondary);
      font-size: 0.72rem;
      line-height: 1.5;
    }

    .timeline-scroll {
      overflow: clip;
    }

    .timeline-key {
      gap: 0.35rem 0.65rem;
    }

    .timeline-node-label {
      max-width: 7.5rem;
      padding: 0.2rem 0.34rem;
      font-size: 0.64rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline-node {
      transition: none;
    }
  }
</style>
