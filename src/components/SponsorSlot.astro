---
import type { Sponsor, Placement } from '../lib/sponsors';
import { placementLink } from '../lib/sponsors';
interface Props { sponsor: Sponsor; placement: Placement; }
const { sponsor, placement } = Astro.props;

/**
 * Sponsor bar. A "GDB-Engines is proudly sponsored by:" line over a row of logo, tagline
 * and a "Learn more" button; wide bars add an "Our sponsors" link to /sponsors/ at the end.
 * Narrow bars keep the sentence too: a bare "Sponsored" tag beside a page's content read
 * as if that page were sponsored. Breakpoints are container queries on the bar's own
 * width. Visibility is toggled on these wrappers, never on the light-only/dark-only logo
 * imgs.
 */
---
<aside class="credit-slot" data-credit-bar aria-label="Sponsored">
  <a class="credit-slot__body" href={placementLink(sponsor.link, placement)} target="_blank"
     rel="noopener noreferrer sponsored" data-outbound="sponsor" data-placement={placement}>
    <span class="credit-slot__label">GDB-Engines is proudly sponsored by:</span>
    <span class="credit-slot__logo">
      <img class="light-only" src={sponsor.logo.light} alt={sponsor.name} height="34" />
      <img class="dark-only" src={sponsor.logo.dark} alt={sponsor.name} height="34" />
    </span>
    <span class="credit-slot__blurb">{sponsor.tagline}</span>
    <span class="credit-slot__more">Learn more <span class="credit-slot__arrow" aria-hidden="true">→</span></span>
  </a>
  <a class="credit-slot__about" href="/sponsors/">Our sponsors</a>
</aside>

<style>
  .credit-slot {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    margin: 0 0 1.25rem;
    overflow: hidden;
    background-color: var(--color-background);
    container-type: inline-size;
    /* Soft brand-tinted glow so the unit stands out from page content; static, and on
       the box only, never the logo. */
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-brand-accent) 10%, transparent),
      0 0.4rem 1.5rem -0.25rem color-mix(in srgb, var(--color-brand-accent) var(--sponsor-glow), transparent);
  }

  .credit-slot__body {
    flex: 1;
    min-width: 0;
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: 'label label label' 'logo blurb more';
    align-items: center;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem 1.1rem 0.9rem;
    text-decoration: none;
    color: var(--color-text);
    transition: background-color 120ms ease;
  }
  .credit-slot__body:hover { background-color: var(--color-surface); }

  .credit-slot__label {
    grid-area: label;
    color: var(--color-text-tertiary);
    font-size: 0.8125rem;
  }
  .credit-slot__logo { grid-area: logo; display: flex; align-items: center; }
  .credit-slot__logo img { height: 34px; width: auto; }

  .credit-slot__blurb {
    grid-area: blurb;
    color: var(--color-text-secondary);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .credit-slot__more {
    grid-area: more;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    background: var(--color-brand-accent);
    color: var(--color-background);
    font-size: 0.8125rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .credit-slot__arrow { display: inline-block; transition: transform 120ms ease; }
  .credit-slot__body:hover .credit-slot__arrow { transform: translateX(3px); }
  @media (prefers-reduced-motion: reduce) {
    .credit-slot__arrow { transition: none; }
  }

  .credit-slot__about {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    padding: 0 1rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
    white-space: nowrap;
    text-decoration: none;
    transition: color 120ms ease, background-color 120ms ease;
  }
  .credit-slot__about:hover {
    color: var(--color-text);
    background: var(--color-surface);
  }

  .credit-slot__about:focus-visible,
  .credit-slot__body:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: -2px;
  }

  @container (max-width: 52rem) {
    .credit-slot__about { display: none; }
  }

  /* Phones: the logo gets its own row, then the tagline beside the button. */
  @container (max-width: 32rem) {
    .credit-slot__body {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'label label' 'logo logo' 'blurb more';
      gap: 0.5rem 0.75rem;
      padding: 0.65rem 0.85rem 0.75rem;
    }
    .credit-slot__label { font-size: 0.75rem; }
    .credit-slot__logo img { height: 28px; }
    .credit-slot__blurb { font-size: 0.8125rem; }
    .credit-slot__more { align-self: end; }
  }
</style>
