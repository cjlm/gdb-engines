---
import { graphStratify, grid, laneGreedy } from 'd3-dag';
import { curveBumpX, line } from 'd3-shape';
import { RELATION_LABELS, type Family, type Relation, type Station } from '../lib/lineage';

interface Props {
  family: Family;
  /** Slug of the engine whose page this is; its station is drawn as "you are here". */
  highlight?: string;
  /** Widest the family is drawn before its time scale compresses to fit. */
  maxWidth?: number;
}

const { family, highlight, maxWidth = 880 } = Astro.props;

const LANE = 84;
const PAD_Y_TOP = 50;
const PAD_Y_BOTTOM = 36;
const PAD_X = 16;
const LABEL_WRAP = 18;
const LABEL_LINE = 15;
/** Horizontal run a branch needs to change lanes. */
const BEND = 44;
/** Minimum clear space between neighbouring stations' text on the same lane. */
const TEXT_GAP = 20;
/** Space kept between a station and the relation labels on its incoming line. */
const LABEL_PAD = 22;
/** Minimum stretch of visible line on either side of a relation label. */
const LINE_RUN = 38;
/** Padding inside the pill drawn behind a relation label. */
const PILL_PAD = 5;
// Horizontal scale bounds, in pixels per year. The scale is the smallest that gives every
// line the room its labels need, clamped so a short family isn't stretched and a long one
// isn't squashed; stations that still collide are nudged apart afterwards.
const MIN_PX_PER_YEAR = 22;
const MAX_PX_PER_YEAR = 90;
// Approximate advance widths, used to keep text from colliding. Labels are 14px Familjen
// Grotesk semibold; captions and relation labels are 12px IBM Plex Mono (0.6em advance).
const LABEL_CHAR = 8;
const MONO_CHAR = 7.2;
/** Number of `--lineage-N` colour tokens defined in global.css, assigned in order. */
const LINE_COLOR_COUNT = 8;
const ROUTE_STYLES: Partial<Record<Relation, string>> = {
  'inspired-by': 'is-dotted',
  'borrows-from': 'is-dashed',
};

const dag = graphStratify()
  .id((s: Station) => s.id)
  .parentIds((s: Station) => s.parents.map((p) => p.id))(family.stations);
// Bidirectional lanes let branches fan out on both sides of their parent's line.
grid().lane(laneGreedy().bidirectional(true)).rank((node) => node.data.when)(dag);

type DagNode = ReturnType<typeof dag.nodes> extends IterableIterator<infer N> ? N : never;
const topological = [...dag.nodes()].sort((a, b) => a.y - b.y);

function wrap(label: string): string[] {
  const lines: string[] = [];
  for (const word of label.split(' ')) {
    const last = lines.at(-1);
    if (last && `${last} ${word}`.length <= LABEL_WRAP) lines[lines.length - 1] = `${last} ${word}`;
    else lines.push(word);
  }
  return lines;
}

function caption(station: Station): string {
  return [station.released?.slice(0, 4), station.ended && 'ended'].filter(Boolean).join(' · ');
}

function radius(station: Station): number {
  if (station.kind === 'current' && station.slug === highlight) return 10;
  return station.kind === 'former' ? 6 : 8;
}

const monoWidth = (text: string) => text.length * MONO_CHAR;

/** Half the widest piece of text drawn above or below a station. */
function halfWidth(station: Station): number {
  const label = Math.max(...wrap(station.label).map((l) => l.length)) * LABEL_CHAR;
  return Math.max(label, monoWidth(caption(station)), radius(station) * 2) / 2;
}

// Relation labels sit on the target's incoming line, nearest the station first. A relation shared
// by several parents is labelled once, since those lines run together into the station.
const relationLabels = new Map<string, { relation: Relation; offset: number; width: number }[]>();
for (const node of topological) {
  const relations = [...new Set(node.data.parents.map((p) => p.relation))];
  let offset = radius(node.data) + LABEL_PAD;
  const labels = [];
  for (const relation of relations) {
    const width = monoWidth(RELATION_LABELS[relation]) + PILL_PAD * 2;
    labels.push({ relation, offset: offset + width, width });
    offset += width + LABEL_PAD;
  }
  relationLabels.set(node.data.id, labels);
}

function labelFor(target: Station, source: Station) {
  const relation = target.parents.find((p) => p.id === source.id)?.relation;
  return relationLabels.get(target.id)!.find((l) => l.relation === relation)!;
}

/**
 * When each station sits in time. Former names and uncatalogued ancestors have no release date,
 * so they are placed between their dated neighbours; a child never sits left of its parent.
 */
function resolveTimes(): Map<DagNode, number> {
  const times = new Map<DagNode, number>();
  for (const node of topological) {
    if (node.data.when !== undefined) times.set(node, node.data.when);
  }
  const datedChildren = (node: DagNode) =>
    [...node.children()].map((c) => times.get(c)).filter((t) => t !== undefined);
  for (const node of [...topological].reverse()) {
    if (times.has(node) || node.nparents() > 0) continue;
    const children = datedChildren(node);
    times.set(node, (children.length ? Math.min(...children) : 0) - 1);
  }
  for (const node of topological) {
    if (node.nparents() === 0) continue;
    const earliest = Math.max(...[...node.parents()].map((p) => times.get(p)!));
    if (!times.has(node)) {
      const children = datedChildren(node);
      const latest = children.length ? Math.min(...children) : earliest + 1;
      times.set(node, latest > earliest ? (earliest + latest) / 2 : earliest + 0.5);
    } else {
      times.set(node, Math.max(times.get(node)!, earliest));
    }
  }
  return times;
}

const times = resolveTimes();
const byTime = [...topological].sort((a, b) => times.get(a)! - times.get(b)! || a.y - b.y);
const laneOf = (node: DagNode) => node.x;

/** Pixels needed between two stations on the same line, or between a parent and its child. */
function sameLaneGap(left: DagNode, right: DagNode): number {
  return halfWidth(left.data) + TEXT_GAP + halfWidth(right.data);
}
function edgeGap(source: DagNode, target: DagNode): number {
  const bent = laneOf(source) !== laneOf(target);
  const clear = bent ? halfWidth(source.data) + BEND : radius(source.data);
  return clear + LINE_RUN + labelFor(target.data, source.data).offset;
}

const constraints: [DagNode, DagNode, number][] = [];
const lastInLane = new Map<number, DagNode>();
for (const node of byTime) {
  const previous = lastInLane.get(laneOf(node));
  if (previous) constraints.push([previous, node, sameLaneGap(previous, node)]);
  lastInLane.set(laneOf(node), node);
  for (const parent of node.parents()) constraints.push([parent, node, edgeGap(parent, node)]);
}

let pxPerYear = MIN_PX_PER_YEAR;
for (const [left, right, gap] of constraints) {
  const years = times.get(right)! - times.get(left)!;
  if (years > 0.05) pxPerYear = Math.max(pxPerYear, gap / years);
}
pxPerYear = Math.min(pxPerYear, MAX_PX_PER_YEAR);
// Fitting the available width wins over the minimum scale; nudging below keeps text apart.
const span = Math.max(...byTime.map((n) => times.get(n)!)) - Math.min(...byTime.map((n) => times.get(n)!));
const textAllowance = Math.max(...byTime.map((n) => halfWidth(n.data))) * 2 + PAD_X * 2;
if (span > 0) pxPerYear = Math.min(pxPerYear, Math.max(0, maxWidth - textAllowance) / span);

const start = Math.min(...byTime.map((n) => times.get(n)! * pxPerYear - halfWidth(n.data)));
const xOf = new Map<DagNode, number>();
for (const node of byTime) xOf.set(node, times.get(node)! * pxPerYear - start + PAD_X);
// Nudge apart anything the clamped scale left too close, in time order so pushes cascade.
for (const node of byTime) {
  let x = xOf.get(node)!;
  for (const [left, right, gap] of constraints) {
    if (right === node) x = Math.max(x, xOf.get(left)! + gap);
  }
  xOf.set(node, x);
}

const lanes = [...new Set(topological.map(laneOf))].sort((a, b) => a - b);
const position = (node: DagNode): [number, number] => [
  xOf.get(node)!,
  PAD_Y_TOP + lanes.indexOf(laneOf(node)) * LANE,
];

// Lines take hues in a fixed order, earliest engine first. A family with more lines than
// validated hues draws the rest in neutral ink rather than repeating a colour.
const lineColor = new Map<string, string>();
function colorFor(station: Station): string {
  const key = station.slug ?? station.id;
  if (!lineColor.has(key)) {
    const slot = lineColor.size + 1;
    lineColor.set(key, slot <= LINE_COLOR_COUNT ? `var(--lineage-${slot})` : 'var(--color-text-tertiary)');
  }
  return lineColor.get(key)!;
}

const nodes = byTime.map((node) => {
  const [x, y] = position(node);
  return { station: node.data, x, y, color: node.data.kind === 'external' ? undefined : colorFor(node.data) };
});

const route = line().curve(curveBumpX);
const links = [...dag.links()].map((link) => {
  const [sx, sy] = position(link.source);
  const [tx, ty] = position(link.target);
  const label = labelFor(link.target.data, link.source.data);
  // Leave the parent clear of its own text, and finish the bend before this line's label.
  const points: [number, number][] = sy === ty
    ? [[sx, sy], [tx, ty]]
    : [
      [sx, sy],
      [sx + halfWidth(link.source.data), sy],
      [tx - label.offset - LINE_RUN, ty],
      [tx, ty],
    ];
  return {
    d: route(points) ?? '',
    color: colorFor(link.target.data),
    style: ROUTE_STYLES[label.relation],
  };
});

// A lone straight line carries its label at its midpoint; where lines bend or several labels
// share one line, labels stack from the station outwards so each stays on its own route.
function soleStraightParent(node: DagNode): DagNode | undefined {
  const parents = [...node.parents()];
  return parents.length === 1 && laneOf(parents[0]) === laneOf(node) ? parents[0] : undefined;
}

const relationTexts = byTime.flatMap((node) => {
  const [x, y] = position(node);
  const parent = soleStraightParent(node);
  return relationLabels.get(node.data.id)!.map((label) => {
    const midpoint = parent
      ? (xOf.get(parent)! + radius(parent.data) + x - radius(node.data)) / 2
      : x - label.offset + label.width / 2;
    return { text: RELATION_LABELS[label.relation], x: midpoint, y, width: label.width };
  });
});

const width = Math.max(...nodes.map(({ station, x }) => x + halfWidth(station))) + PAD_X;
const height = PAD_Y_TOP + PAD_Y_BOTTOM + (lanes.length - 1) * LANE;
---
<div class="lineage-map">
  <svg
    viewBox={`0 0 ${width} ${height}`}
    width={width}
    height={height}
    role="img"
    aria-label={`${family.title} family: ${family.stations.map((s) => s.label).join(', ')}`}
  >
    <g class="lineage-routes">
      {links.map((link) => (
        <path d={link.d} style={`--line: ${link.color}`} class={link.style} />
      ))}
    </g>
    <g class="lineage-relations" aria-hidden="true">
      {relationTexts.map(({ text, x, y, width }) => (
        <>
          <rect x={x - width / 2} y={y - 9} width={width} height={18} rx={9} />
          <text x={x} y={y}>{text}</text>
        </>
      ))}
    </g>
    {nodes.map(({ station, x, y, color }) => {
      const labelLines = wrap(station.label);
      const isHere = station.kind === 'current' && station.slug === highlight;
      const marker = (
        <>
          <circle
            cx={x}
            cy={y}
            r={radius(station)}
            class:list={['lineage-station', `is-${station.kind}`, isHere && 'is-here']}
            style={color ? `--line: ${color}` : undefined}
          />
          {station.ended && (
            <path
              class:list={['lineage-ended', isHere && 'is-here']}
              d={`M${x - 3.5} ${y - 3.5}L${x + 3.5} ${y + 3.5}M${x + 3.5} ${y - 3.5}L${x - 3.5} ${y + 3.5}`}
            />
          )}
          <text
            class:list={['lineage-label', station.kind !== 'current' && 'is-muted']}
            x={x}
            y={y - 18 - (labelLines.length - 1) * LABEL_LINE}
          >
            {labelLines.map((text, i) => <tspan x={x} dy={i === 0 ? 0 : LABEL_LINE}>{text}</tspan>)}
          </text>
          <text class="lineage-caption" x={x} y={y + 28}>{caption(station)}</text>
        </>
      );
      return station.kind === 'current' && !isHere
        ? <a href={`/db/${station.slug}/`}>{marker}</a>
        : <g>{marker}</g>;
    })}
  </svg>
</div>

<style>
  .lineage-map {
    overflow-x: auto;
    scrollbar-color: var(--color-border) transparent;
    padding-block: 0.25rem;
  }

  .lineage-map svg {
    display: block;
    margin-inline: auto;
  }

  .lineage-routes path {
    fill: none;
    stroke: var(--line);
    stroke-width: 4;
    stroke-linecap: round;
  }

  .lineage-routes path.is-dotted {
    stroke-dasharray: 0.1 8;
  }

  .lineage-routes path.is-dashed {
    stroke-dasharray: 9 6;
    stroke-linecap: butt;
  }

  .lineage-station {
    fill: var(--color-background);
    stroke: var(--line);
    stroke-width: 3;
  }

  .lineage-station.is-external {
    fill: var(--color-surface);
    stroke: var(--color-text-tertiary);
  }

  .lineage-station.is-here {
    fill: var(--line);
    stroke: var(--color-text);
  }

  .lineage-ended {
    stroke: var(--lineage-ended);
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .lineage-ended.is-here {
    stroke: var(--color-background);
  }

  /* A background-coloured outline behind every glyph keeps text legible where a line passes. */
  .lineage-label,
  .lineage-caption {
    paint-order: stroke;
    stroke: var(--color-background);
    stroke-width: 4px;
    stroke-linejoin: round;
    text-anchor: middle;
  }

  .lineage-label {
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 600;
    fill: var(--color-text);
  }

  .lineage-label.is-muted {
    fill: var(--color-text-secondary);
    font-weight: 400;
  }

  .lineage-caption,
  .lineage-relations text {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--color-text-tertiary);
  }

  .lineage-relations rect {
    fill: var(--color-background);
    stroke: var(--color-border);
    stroke-width: 1;
  }

  .lineage-relations text {
    dominant-baseline: central;
    text-anchor: middle;
    fill: var(--color-text-secondary);
  }

  a {
    text-decoration: none;
  }

  a:hover .lineage-label,
  a:focus-visible .lineage-label {
    fill: var(--color-brand-accent);
  }

  a:hover .lineage-station,
  a:focus-visible .lineage-station {
    stroke-width: 4;
  }
</style>
