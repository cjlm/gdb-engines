---
/**
 * The knowledge graph board's body on /rankings/knowledge-graph/: one ranked table giving each
 * engine's kind and the knowledge graph capabilities it ships or adds by extension, with a filter
 * that narrows it to one kind. `#semantic` and the other filter ids work as links into the page.
 */
import { getCollection } from 'astro:content';
import DatabaseLogo from './DatabaseLogo.astro';
import type { RankedEngine } from '../lib/rankings';
import { rankMovement } from '../lib/rank-movement';
import {
  KG_CAPABILITIES,
  kgCapabilityDescriptions,
  kgKindLabels,
  kgKindsOf,
  type KgCapability,
  type KgKind,
} from '../lib/knowledge-graph';

interface Props {
  engines: RankedEngine[];
  faviconMap: Record<string, string>;
  engineMeta: Record<string, { description: string }>;
}

const { engines, faviconMap, engineMeta } = Astro.props;
const catalogue = new Map((await getCollection('databases')).map(({ data }) => [data.slug, data]));
const shortKind = (kind: KgKind) => kgKindLabels[kind].split(' (')[0];

/** Kinds reuse the type badges' colours: RDF's for semantic, the query engines' for virtual. */
const kindBadge: Record<KgKind, string> = {
  semantic: 'badge-rdf',
  'property-graph': 'badge-property-graph',
  virtual: 'badge-query-engine',
};

/** Column headings short enough to sit above a tick. */
const capabilityHeadings: Record<KgCapability, string> = {
  'SPARQL 1.1': 'SPARQL 1.1',
  'RDFS reasoning': 'RDFS',
  'OWL reasoning': 'OWL',
  'SHACL validation': 'SHACL',
  'R2RML mapping': 'R2RML',
  'Vector search': 'Vector search',
  'Graph algorithms': 'Graph algorithms',
};

type Support = 'built-in' | 'extension' | 'none';
const rows = engines.map((engine) => {
  const db = catalogue.get(engine.slug);
  const kinds = db ? kgKindsOf(db) : [];
  const support = (capability: KgCapability): Support => {
    if (db?.kg_capabilities.includes(capability)) return 'built-in';
    if (db?.kg_extension_capabilities.includes(capability)) return 'extension';
    return 'none';
  };
  return {
    engine,
    kinds,
    matches: [...kinds, ...(db?.ai_roles ?? [])] as string[],
    support: KG_CAPABILITIES.map((capability) => ({ capability, level: support(capability) })),
  };
});
const hasDeltas = engines.some((e) => e.rankDelta1m !== null);

interface Filter {
  id: 'all' | KgKind | 'graphrag' | 'agent-memory';
  label: string;
  /** What puts an engine in this group. */
  note: string;
  more?: { href: string; label: string };
}
const filters = (
  [
    {
      id: 'all',
      label: 'All',
      note:
        'Ordered by popularity score. The columns on the right show which parts of a knowledge ' +
        'graph each engine supplies.',
    },
    {
      id: 'semantic',
      label: shortKind('semantic'),
      note:
        'Answers SPARQL 1.1 itself, so it stores RDF and can hold an ontology as data next to ' +
        'the facts.',
    },
    {
      id: 'property-graph',
      label: shortKind('property-graph'),
      note: 'A labelled property graph database whose makers present it for knowledge graphs.',
    },
    {
      id: 'virtual',
      label: shortKind('virtual'),
      note:
        'Builds the graph over data left where it is, in relational databases, warehouses or ' +
        'lakes.',
    },
    {
      id: 'graphrag',
      label: 'GraphRAG',
      note: 'Listed above and also used to ground LLM answers in a graph.',
      more: {
        href: '/rankings/graph-databases-graphrag-knowledge-grounding/',
        label: 'Full GraphRAG ranking',
      },
    },
    {
      id: 'agent-memory',
      label: 'Agent memory',
      note: 'Listed above and also used as memory for AI agents.',
      more: { href: '/rankings/graph-databases-agent-memory/', label: 'Full agent memory ranking' },
    },
  ] satisfies Filter[]
)
  .map((filter) => ({
    ...filter,
    count:
      filter.id === 'all' ? rows.length : rows.filter((r) => r.matches.includes(filter.id)).length,
  }))
  .filter((filter) => filter.count > 0);
---
<p class="kg-guide-link">
  New to the term? <a href="/knowledge-graph/">What a knowledge graph is, and how the kinds
  differ</a>.
</p>

<div class="kg-board">
  {filters.map((filter, i) => (
    <input
      type="radio"
      name="kg-filter"
      id={`kg-filter-${filter.id}`}
      class="kg-filter-input"
      data-filter={filter.id}
      checked={i === 0}
    />
  ))}
  <div class="kg-filter-labels">
    <span class="kg-filter-title" aria-hidden="true">Show</span>
    {filters.map((filter) => (
      <label for={`kg-filter-${filter.id}`} class={`kg-filter-label kg-filter-label-${filter.id}`}>
        {filter.label} <span class="count">{filter.count}</span>
      </label>
    ))}
  </div>
  {filters.map((filter) => (
    <p class={`kg-filter-note kg-filter-note-${filter.id}`}>
      {filter.note}
      {filter.more && <> <a href={filter.more.href}>{filter.more.label}</a>.</>}
    </p>
  ))}
  <p class="kg-scroll-hint">Scroll the table sideways for kind and capabilities.</p>

  <div class="kg-table-wrap">
    <table class="kg-table">
      <thead>
        <tr>
          <th class="num rank-cell sticky-rank-column">#</th>
          {hasDeltas && <th class="num">1mo</th>}
          <th class="sticky-name-column">Name</th>
          <th class="num">Score</th>
          <th>Kind</th>
          {KG_CAPABILITIES.map((c, i) => (
            <th class:list={['cap', { 'cap-first': i === 0 }]} title={kgCapabilityDescriptions[c]}>
              {capabilityHeadings[c]}
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map(({ engine, kinds, matches, support }, i) => {
          const movement = rankMovement(engine.rankDelta1m);
          const logo = faviconMap[engine.slug];
          return (
            <tr class:list={matches.map((id) => `kg-is-${id}`)}>
              <td class="num rank-cell sticky-rank-column">
                <span class="rank-overall">{i + 1}</span>
              </td>
              {hasDeltas && (
                <td class="num">
                  <span class={`rank-delta ${movement.cls}`}>{movement.text}</span>
                </td>
              )}
              <td class="sticky-name-column">
                <div class="name-cell">
                  {logo && <DatabaseLogo src={logo} size={16} loading="lazy" />}
                  <a
                    href={`/db/${engine.slug}/`}
                    class="has-tooltip"
                    aria-label={engineMeta[engine.slug]?.description || engine.name}
                    data-microtip-position="top-right"
                    data-microtip-size="medium"
                    role="tooltip"
                  >{engine.name}</a>
                </div>
              </td>
              <td class="num">{engine.score.toFixed(1)}</td>
              <td class="kinds">
                {kinds.map((kind) => (
                  <span class={`badge ${kindBadge[kind]}`}>{shortKind(kind)}</span>
                ))}
              </td>
              {support.map(({ capability, level }, j) => (
                <td class:list={['cap', { 'cap-first': j === 0 }]}>
                  {level === 'built-in' && (
                    <span class="yes" title={`${capability}: ships with the engine`}>
                      &#10003;<span class="sr-only"> ships with the engine</span>
                    </span>
                  )}
                  {level === 'extension' && (
                    <span class="ext" title={`${capability}: added by the makers' extension`}>
                      &#9675;<span class="sr-only"> added by the makers' extension</span>
                    </span>
                  )}
                  {level === 'none' && <span class="sr-only">no source found</span>}
                </td>
              ))}
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="kg-key">
    <span><b class="yes">&#10003;</b> ships with the engine</span>
    <span><b class="ext">&#9675;</b> added by an extension from the same makers</span>
    <span>blank: no official source found</span>
  </p>
</div>

<section class="kg-about" aria-labelledby="kg-about-heading">
  <h2 id="kg-about-heading">Reading the table</h2>
  <p>
    Engines are ordered by the monthly <a href="/rankings/overall/">popularity score</a>: adoption,
    activity, community and research signals. The capability columns do not affect the order. They
    follow the parts of a knowledge graph architecture that an engine can supply, as Jessica
    Talisman lays them out in <cite>Ontology Pipeline</cite>; the
    <a href="/knowledge-graph/#parts">guide</a> covers the parts a team has to write itself.
  </p>
  <dl class="kg-columns">
    {KG_CAPABILITIES.map((c) => (
      <div>
        <dt>{c}</dt>
        <dd>{kgCapabilityDescriptions[c]}</dd>
      </div>
    ))}
  </dl>
  <p>
    The columns from SPARQL 1.1 to R2RML belong to the RDF stack, so a property graph database
    reaches them only through an extension, such as Neo4j Labs' neosemantics, or a separate tool.
    A blank cell means we found no official source. A third-party tool may still supply the
    capability.
  </p>
  <p>
    Kinds and capabilities come from the makers' documentation and repositories. Each value carries
    a verbatim quote, listed with its source on the engine's page, and a value is published only
    once its quote has been refetched and found on the cited page.
  </p>
</section>

<script>
  // Let a link such as /rankings/knowledge-graph/#semantic open the table on that filter.
  function applyHashFilter() {
    const id = location.hash.slice(1);
    const input = document.querySelector<HTMLInputElement>(
      `.kg-filter-input[data-filter="${CSS.escape(id)}"]`,
    );
    if (input) input.checked = true;
  }
  applyHashFilter();
  window.addEventListener('hashchange', applyHashFilter);
</script>

<style>
  .kg-guide-link { margin: 0 0 1rem; font-size: 0.9rem; color: var(--color-text-secondary); }
  .kg-guide-link a,
  .kg-filter-note a,
  .kg-about a {
    color: var(--color-text);
    text-decoration-color: var(--color-border);
    text-underline-offset: 2px;
  }

  .kg-filter-input { position: absolute; opacity: 0; pointer-events: none; }
  .kg-filter-labels { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .kg-filter-title {
    margin-right: 0.2rem;
    color: var(--color-text-tertiary);
    font-size: 0.75rem;
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }
  .kg-filter-label {
    cursor: pointer;
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--color-text-secondary);
  }
  .kg-filter-label:hover { color: var(--color-text); border-color: var(--color-text-tertiary); }
  .kg-filter-label .count { color: var(--color-text-tertiary); font-size: 0.8rem; }
  .kg-filter-note {
    display: none;
    margin: 0.6rem 0 0.9rem;
    max-width: 90ch;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* Below this width the table is wider than the page and its right-hand columns start
     off screen. */
  .kg-scroll-hint { display: none; }
  @media (max-width: 80rem) {
    .kg-filter-note { margin-bottom: 0.2rem; }
    .kg-scroll-hint {
      display: block;
      margin: 0 0 0.9rem;
      color: var(--color-text-tertiary);
      font-size: 0.85rem;
    }
  }

  /* One rule per filter: the checked radio marks its label, shows its note and hides the rows
     of every other group. */
  #kg-filter-all:checked ~ .kg-filter-labels .kg-filter-label-all,
  #kg-filter-semantic:checked ~ .kg-filter-labels .kg-filter-label-semantic,
  #kg-filter-property-graph:checked ~ .kg-filter-labels .kg-filter-label-property-graph,
  #kg-filter-virtual:checked ~ .kg-filter-labels .kg-filter-label-virtual,
  #kg-filter-graphrag:checked ~ .kg-filter-labels .kg-filter-label-graphrag,
  #kg-filter-agent-memory:checked ~ .kg-filter-labels .kg-filter-label-agent-memory {
    border-color: var(--color-brand-accent);
    background: var(--color-brand-accent);
    color: var(--color-text-invert);
  }
  #kg-filter-all:checked ~ .kg-filter-labels .kg-filter-label-all .count,
  #kg-filter-semantic:checked ~ .kg-filter-labels .kg-filter-label-semantic .count,
  #kg-filter-property-graph:checked ~ .kg-filter-labels .kg-filter-label-property-graph .count,
  #kg-filter-virtual:checked ~ .kg-filter-labels .kg-filter-label-virtual .count,
  #kg-filter-graphrag:checked ~ .kg-filter-labels .kg-filter-label-graphrag .count,
  #kg-filter-agent-memory:checked ~ .kg-filter-labels .kg-filter-label-agent-memory .count {
    color: inherit;
  }
  #kg-filter-all:checked ~ .kg-filter-note-all,
  #kg-filter-semantic:checked ~ .kg-filter-note-semantic,
  #kg-filter-property-graph:checked ~ .kg-filter-note-property-graph,
  #kg-filter-virtual:checked ~ .kg-filter-note-virtual,
  #kg-filter-graphrag:checked ~ .kg-filter-note-graphrag,
  #kg-filter-agent-memory:checked ~ .kg-filter-note-agent-memory { display: block; }
  #kg-filter-semantic:checked ~ .kg-table-wrap tbody tr:not(.kg-is-semantic),
  #kg-filter-property-graph:checked ~ .kg-table-wrap tbody tr:not(.kg-is-property-graph),
  #kg-filter-virtual:checked ~ .kg-table-wrap tbody tr:not(.kg-is-virtual),
  #kg-filter-graphrag:checked ~ .kg-table-wrap tbody tr:not(.kg-is-graphrag),
  #kg-filter-agent-memory:checked ~ .kg-table-wrap tbody tr:not(.kg-is-agent-memory) {
    display: none;
  }
  .kg-filter-input:focus-visible ~ .kg-filter-labels {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 4px;
  }

  /* The rank is the engine's place on the whole board. Under a filter the visible rows are
     renumbered instead: a hidden row does not advance the counter. */
  .kg-table tbody { counter-reset: kg-rank; }
  .kg-table tbody tr { counter-increment: kg-rank; }
  .kg-filter-input:not(#kg-filter-all):checked ~ .kg-table-wrap .rank-overall { display: none; }
  .kg-filter-input:not(#kg-filter-all):checked ~ .kg-table-wrap td.rank-cell::before {
    content: counter(kg-rank);
  }

  /* Positioned so the visually hidden cell text stays inside the scrolling box. */
  .kg-table-wrap {
    position: relative;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  /* Size to content but never below the wrap, which scrolls sideways when the table is wider. */
  .kg-table {
    margin-top: 0;
    width: max-content;
    min-width: 100%;
    --sticky-name-left: 2.25rem;
  }
  .kg-table thead th { top: 0; }
  .kg-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .kg-table .rank-cell {
    width: 2.25rem;
    min-width: 2.25rem;
    max-width: 2.25rem;
    padding-left: 0.5rem;
    padding-right: 0.5rem;
  }
  .kg-table tbody td.rank-cell { color: var(--color-text); font-weight: 500; }
  .kg-table a { color: inherit; text-decoration: none; }
  .kg-table a:hover { text-decoration: underline; }
  .kg-table .name-cell { display: flex; align-items: center; gap: 0.5rem; }
  .kg-table .kinds .badge + .badge { margin-left: 0.25rem; }
  .kg-table th.cap {
    width: 5.25rem;
    min-width: 5.25rem;
    padding-left: 0.4rem;
    padding-right: 0.4rem;
    text-align: center;
    white-space: normal;
    line-height: 1.25;
    vertical-align: bottom;
  }
  .kg-table td.cap { text-align: center; font-size: 1rem; line-height: 1; }
  .kg-table .cap-first { border-left: 1px solid var(--color-border); }
  .kg-table tbody tr:hover td { background-color: var(--color-surface); }
  .yes { color: var(--color-text); font-weight: 600; }
  .ext { color: var(--color-text-secondary); }

  .kg-key {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.5rem;
    margin: 0.75rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.85rem;
  }
  .kg-key b { margin-right: 0.15rem; }

  .kg-about { max-width: 90ch; margin-top: 2.5rem; }
  .kg-about h2 { margin: 0 0 0.5rem; font-size: 1.15rem; color: var(--color-text); }
  .kg-about p { margin: 0 0 0.75rem; color: var(--color-text-secondary); line-height: 1.55; }
  .kg-columns { margin: 0 0 0.75rem; font-size: 0.9rem; line-height: 1.5; }
  .kg-columns div {
    display: grid;
    grid-template-columns: 10rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.35rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .kg-columns dt { color: var(--color-text); font-weight: 500; }
  .kg-columns dd { margin: 0; color: var(--color-text-secondary); }
  @media (max-width: 39rem) {
    .kg-columns div { grid-template-columns: minmax(0, 1fr); gap: 0; }
  }
</style>
