  .sponsor-badge summary:hover,
  .sponsor-badge[open] summary {
    background: color-mix(in srgb, var(--color-brand-accent) 12%, transparent);
  }

  .sponsor-badge summary:focus-visible {
    outline: 2px solid var(--color-brand-accent);
