<details class="sponsor-badge">
  <summary>Sponsor us</summary>
  <div class="sponsor-badge__details">
    <strong>Support independent graph database research.</strong>
    <p>
      Sponsorship sustains GDB-Engines and helps vendors reach people comparing
      graph databases. Rankings and methodology are never adjusted for sponsors.
    </p>
    <a href="/sponsor/">Sponsorship details <span aria-hidden="true">→</span></a>
  </div>
</details>

<script>
  const sponsorBadge = document.querySelector<HTMLDetailsElement>('.sponsor-badge');

  if (sponsorBadge) {
    document.addEventListener('click', (event) => {
      if (!sponsorBadge.contains(event.target as Node)) sponsorBadge.open = false;
    });

    sponsorBadge.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        sponsorBadge.open = false;
        sponsorBadge.querySelector('summary')?.focus();
      }
    });
  }
</script>

